---
import {translate,localePath,type Locale} from '../lib/locale.ts';
import {coursePath,chapterProgressId,type Course} from '../data/course-types.ts';
import {courseCatalogTopic} from '../data/topic-categories.ts';
import Icon from './Icon.astro';
interface Props {course: Course;locale?: Locale;heading?:'h2'|'h3'}
const {course,locale='de',heading:Heading='h3'}=Astro.props;
const t=translate(locale);
const steps=course.chapters.map(chapter=>({id:chapterProgressId(course,chapter),url:localePath(locale,coursePath(course,chapter)),title:chapter.title[locale]}));
---
<article class="catalog-course" data-catalog-course data-course={course.id} data-title={`${course.title[locale]} ${course.description[locale]}`.toLocaleLowerCase(locale)} data-topic={courseCatalogTopic(course)}>
 <div class="catalog-course-meta"><span class="available-badge">{t('Alle Kapitel verfügbar','All chapters available')}</span><span>{course.chapters.length} {t('Kapitel','chapters')}</span></div>
 <Heading><a href={localePath(locale,coursePath(course))}>{course.title[locale]}</a></Heading>
 <p>{course.description[locale]}</p>
 <p class="catalog-levels">{t('Einstieg → Vertiefung → Profi','Beginner → Intermediate → Advanced')} · {course.chapters.reduce((sum,ch)=>sum+ch.questions.length,0)} {t('Quizfragen','quiz questions')}</p>
 <p class="catalog-progress" data-signed-in hidden data-path-lesson-ids={JSON.stringify(steps.map(step=>step.id))}></p>
 <a data-route-next data-route-card data-route-steps={JSON.stringify(steps)} class="button primary" href={localePath(locale,coursePath(course,course.chapters[0]))}>{t('Mit Kapitel 1 beginnen','Start with chapter 1')} <Icon name="arrow" size={17}/></a>
 <a class="text-link" href={localePath(locale,coursePath(course))}>{t('Inhalt & Voraussetzungen','Contents & prerequisites')}</a>
</article>
