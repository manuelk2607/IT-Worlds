---
import{readFileSync}from'node:fs';import{resolve}from'node:path';
import Layout from '../layouts/Layout.astro';import Breadcrumbs from './Breadcrumbs.astro';import ProjectProgress from './ProjectProgress.astro';import CodeExample from './CodeExample.astro';import SourceCard from './SourceCard.astro';
import{courses,coursePath}from'../data/courses.ts';import{guidedLearningPaths}from'../data/learning-paths.ts';
import type{ProjectGuide}from'../data/project-guides.ts';import{parseProgram,runMachine}from'../../public/projekte/cpu/core.ts';
import{translate,localePath,getContent,type Locale}from'../lib/i18n.ts';import'../styles/projects.css';import'../styles/courses.css';
interface Props{project:ProjectGuide;locale:Locale}const{project,locale}=Astro.props;const t=translate(locale);const{levelName}=getContent(locale);
const related=courses.filter(course=>project.courses.includes(course.id)),paths=guidedLearningPaths(locale).filter(path=>path.steps.some(step=>related.some(course=>step.contentId?.startsWith(course.id+'-'))));
const files=project.files.map(name=>({name,code:readFileSync(resolve('public/projekte',project.id,name),'utf8')}));
const trace=runMachine(parseProgram([{op:'set',value:2},{op:'add',value:3},{op:'out'},{op:'halt'}])).trace;
---
<Layout locale={locale} title={project.title[locale]} description={project.description[locale]} active="uebungen">
 <Breadcrumbs locale={locale} items={[{title:t('Übungen','Practice'),href:'/uebungen/'},{title:project.title[locale]}]}/>
 <header class="container page-top"><p class="eyebrow">{t('VOLLSTÄNDIGES LOKALES PROJEKT','COMPLETE LOCAL PROJECT')} · {levelName(project.level)}</p><h1>{project.title[locale]}</h1><p class="page-lead">{project.description[locale]}</p><h2>{t('Voraussetzungen & Werkzeuge','Prerequisites & tools')}</h2><p>{project.prerequisites[locale]}</p><a class="button primary" href={`/downloads/${project.id}.zip`} download>{t('Vollständiges Projekt herunterladen','Download complete project')}</a><p class="muted">{t('Keine laufenden Kosten, keine Zugangsdaten und keine Netzwerkdienste nötig. Dateien bleiben in deinem eigenen Übungsordner.','No recurring costs, credentials or network services required. Files remain in your own practice folder.')}</p></header>
 <section class="container section"><h2>{t('Deine Lernziele','Your learning goals')}</h2><ul>{project.goals.map(goal=><li>{goal[locale]}</li>)}</ul><h2>{t('Überprüfbares Ergebnis','Verifiable result')}</h2><p>{project.result[locale]}</p><div class="project-flow" aria-label={t('Datenfluss im Projekt','Project data flow')}>{[t('Eingabe','Input'),t('Vertrag prüfen','Validate contract'),t('Berechnen / vergleichen','Calculate / compare'),t('Ergebnis prüfen','Check outcome')].map((label,index)=><><span>{label}</span>{index<3&&<b aria-hidden="true">→</b>}</>)}</div></section>
 <ProjectProgress id={project.id} locale={locale}/>
 <article class="container section course-article project-article"><nav class="chapter-toc" aria-label={t('Projektschritte','Project steps')}>{project.steps.map(step=><a href={`#${step.id}`}>{step.title[locale]}</a>)}<a href="#referenz">{t('Vollständige Referenz','Complete reference')}</a></nav>
 {project.steps.map(step=><section id={step.id}><h2>{step.title[locale]}</h2>{step.paragraphs.map(paragraph=><p>{paragraph[locale]}</p>)}{step.code&&<CodeExample code={step.code} language="Shell" locale={locale}/>} {step.solution&&<details><summary>{t('Lösungsweg & Begründung vergleichen','Compare solution & reasoning')}</summary><p>{step.solution[locale]}</p></details>}</section>)}
 {project.id==='cpu'&&<section data-cpu-project data-trace={JSON.stringify(trace)}><h2>{t('Den festen Beispieltrace schrittweise nachvollziehen','Step through the fixed example trace')}</h2><p>{t('Sage den nächsten Akkumulatorwert voraus und zeige dann einen Schritt. Es läuft nur der feste Beispieltrace aus dem getesteten Projekt; kein hochgeladener oder frei eingegebener Code.','Predict the next accumulator value, then reveal one step. Only the fixed example trace from the tested project is shown; no uploaded or arbitrary input code runs.')}</p><p data-cpu-state role="status">PC 0 · ACC 0</p><button class="button primary" data-cpu-next>{t('Nächsten Schritt zeigen','Show next step')}</button> <button class="button secondary" data-cpu-reset>{t('Neu beginnen','Restart')}</button><ol data-cpu-history></ol></section>}
 <section id="referenz"><h2>{t('Vollständige Referenz & Tests','Complete reference & tests')}</h2><p>{t('Alle Dateien entsprechen dem Download und den tatsächlich ausgeführten Regressionstests. Untersuche zuerst Eingabe, Kern und Tests; vergleiche die Referenz nach deinem eigenen Versuch. Es werden keine fehlenden Projektteile vorausgesetzt.','Every file matches the download and the actual regression-test source. Inspect input, core and tests first; compare the reference after your own attempt. No missing project parts are assumed.')}</p>{files.map(file=><details><summary>{file.name}</summary><p><a href={`/projekte/${project.id}/${file.name}`} download>{t('Datei herunterladen','Download file')}</a></p><CodeExample code={file.code} language={file.name.endsWith('.ts')?'TypeScript':file.name.endsWith('.json')?'JSON':file.name.endsWith('.md')?'Markdown':'Text'} locale={locale}/></details>)}</section>
 <section><h2>{t('Passende Kurse, Übungen & Quiz','Related courses, exercises & quizzes')}</h2><ul>{related.map(course=><li><a href={localePath(locale,coursePath(course))}>{course.title[locale]}</a> · <a href={localePath(locale,`/uebungen/?kurs=${course.id}`)}>{t('Aufgaben','Tasks')}</a> · <a href={localePath(locale,`/quiz/?kurs=${course.id}`)}>{t('Kursquiz','Course quiz')}</a></li>)}</ul>{paths.length>0&&<><h3>{t('Themen verbinden','Connect topics')}</h3><ul>{paths.map(path=><li><a href={localePath(locale,`/lernpfade/${path.id}/`)}>{path.title}</a></li>)}</ul></>}</section>
 <section id="quellen"><h2>{t('Quellen & Prüfgrenzen','Sources & limits')}</h2><p>{t('Die Quellen belegen Sprach-/Plattformgrundlagen. Projektvertrag und Tests sind eigene Lernmodelle. Quellenabgleich und erfolgreiche Ausführung ersetzen kein unabhängiges Fachreview.','Sources support language/platform foundations. Project contracts and tests are original learning models. Source matching and successful execution do not replace independent expert review.')}</p>{project.sources.map(id=><SourceCard id={id} locale={locale} compact/>)}</section>
 </article><script src="../scripts/cpu-project.ts"></script>
</Layout>
<style>.project-flow{display:flex;align-items:center;justify-content:center;gap:.8rem;flex-wrap:wrap;margin-block:1.5rem}.project-flow span{padding:1rem;border:1px solid var(--line);background:var(--white);border-radius:10px}.project-flow b{color:var(--blue)}.page-top h2{font-size:1.2rem;margin-top:1.5rem}</style>
