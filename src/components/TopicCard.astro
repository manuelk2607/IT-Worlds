---
import { translate, localePath, type Locale } from "../lib/i18n";
const locale: Locale = Astro.props.locale ?? "de";
const t = translate(locale);
import type { Topic } from "../data/content";
import Icon from "./Icon.astro";
import { courses } from "../data/courses.ts";
import {courseCatalogTopic} from '../data/topic-categories.ts';
interface Props {
  locale?: Locale;
  topic: Topic;
  index?: number;
  href?: string;
  chapterCount?: number;
}
const { topic, index = 0, href = `/themen/${topic.id}/`, chapterCount } = Astro.props;
const chapters=chapterCount ?? courses.filter(course=>courseCatalogTopic(course)===topic.id).reduce((sum,course)=>sum+course.chapters.length,0);
---

<a
  href={localePath(locale, href)}
  class={`topic-card color-${topic.color}`}
  data-topic-card
  data-group={topic.group}
  data-search={`${topic.title} ${topic.short} ${topic.tags.join(" ")} ${Object.values(topic.curriculum).flat().join(" ")}`.toLocaleLowerCase(locale)}
>
  <div class="card-top">
    <span class="topic-icon">
      <Icon name={topic.icon} size={25} />
    </span>
    <span class="card-number">{String(index + 1).padStart(2, "0")}</span>
  </div>
  <h3>{topic.title}</h3>
  <p>{topic.short}</p>
  <div class="topic-tags">
    {topic.tags.map((tag) => (
      <span>{tag}</span>
    ))}
  </div>
  <div class="card-bottom">
    <span>
      {chapters ? t(`${chapters} Kapitel verfügbar`,`${chapters} chapters available`) : topic.lesson ? t("Einstieg verfügbar", "Introduction available") : t("Themenplan entdecken", "Explore the outline")}
      <span class="dot-separator">·</span>{t("3 Lernstufen", "3 levels")}
    </span>
    <Icon name="arrow" size={19} />
  </div>
</a>
