---
import Layout from '../layouts/Layout.astro';import Breadcrumbs from './Breadcrumbs.astro';import PracticeTracker from './PracticeTracker.astro';import SourceCard from './SourceCard.astro';import type{OrderingChallenge}from'../data/practice-challenges.ts';import{courses,coursePath}from'../data/courses.ts';import{translate,localePath,type Locale}from'../lib/locale.ts';import'../styles/exercises.css';
interface Props{challenge:OrderingChallenge;locale:Locale}const{challenge,locale}=Astro.props;const t=translate(locale);const course=courses.find(course=>course.id===challenge.course)!;
const data=challenge.steps.map(step=>({id:step.id,title:step.title[locale],why:step.why[locale]}));
---
<Layout locale={locale} title={challenge.title[locale]} description={challenge.task[locale]} active="uebungen"><Breadcrumbs locale={locale} items={[{title:t('Übungen','Practice'),href:'/uebungen/'},{title:challenge.title[locale]}]}/><header class="container page-top"><p class="eyebrow">{t('ABLAUF ORDNEN','ORDER A SEQUENCE')}</p><h1>{challenge.title[locale]}</h1><p class="page-lead">{challenge.task[locale]}</p><p><a href={localePath(locale,coursePath(course))}>{course.title[locale]}</a> · <a href={localePath(locale,challenge.projectPath)}>{t('Passendes vollständiges Projekt','Related complete project')}</a> · <a href={localePath(locale,`/quiz/?kurs=${course.id}`)}>{t('Kursquiz','Course quiz')}</a></p></header>
 <section class="container section ordering-task" data-ordering-task={`ordering-${challenge.id}`} data-ordering-steps={JSON.stringify(data)}><h2>{t('Reihenfolge begründen','Explain the sequence')}</h2><p>{t('Verschiebe die Schritte mit den Hoch-/Runter-Buttons. Ziehen ist nicht erforderlich. Prüfe deine Reihenfolge; Feedback erklärt die erste Abweichung. Ein grünes Ergebnis belegt nur dieses konkrete Lernmodell.','Move steps with the up/down buttons; dragging is unnecessary. Check your sequence; feedback explains the first mismatch. A green result establishes only this specific learning model.')}</p><ol data-ordering-list></ol><button class="button primary" data-ordering-check>{t('Reihenfolge prüfen','Check sequence')}</button> <button class="button secondary" data-ordering-reset>{t('Neu beginnen','Restart')}</button><p role="status" data-ordering-feedback></p><details><summary>{t('Lösung & Begründungen','Solution & reasoning')}</summary><ol>{challenge.steps.map(step=><li><strong>{step.title[locale]}</strong><p>{step.why[locale]}</p></li>)}</ol></details><PracticeTracker id={`ordering-${challenge.id}`} locale={locale}/><noscript><p>{t('Die interaktive Reihenfolge benötigt Browser-Skripte. Aufgabenstellung und begründete Lösung bleiben lesbar.','Interactive ordering needs browser scripts. The task and explained solution remain readable.')}</p></noscript></section><section class="container section"><h2>{t('Quellen & Modellgrenze','Sources & model limits')}</h2>{challenge.sources.map(id=><SourceCard id={id} locale={locale} compact/>)}</section><script src="../scripts/ordering.ts"></script></Layout>
<style>.ordering-task li{margin:1rem 0;padding:.8rem;border:1px solid var(--line);border-radius:10px}.ordering-task [data-ordering-list] button{min-height:44px;margin:.5rem .5rem 0 0;padding:.5rem;border:1px solid var(--line);border-radius:8px;background:var(--white);color:var(--ink)}.ordering-task [data-ordering-list] button:disabled{opacity:.45}</style>
