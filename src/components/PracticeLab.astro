---
import {translate,localePath,type Locale} from '../lib/i18n.ts';
import '../styles/practice.css';
interface Props {topic:string;locale:Locale}
const {topic,locale}=Astro.props;const t=translate(locale);
---
{topic==='zehn-finger-schreiben'?<section class="practice-lab" id="labor"><h2>{t('Direkt Tastschreiben üben','Practise touch typing now')}</h2><a class="button primary" href={localePath(locale,'/schreibtrainer/')}>{t('Schreibtrainer öffnen →','Open typing trainer →')}</a></section>:topic==='hardware-software'?<section id="labor" class="practice-lab" data-hardware-lab><h2>{t('Hardware-Labor','Hardware lab')}</h2><p>{t('Eigene vereinfachte Modelle: Gatter, Rechenablauf und Bootkette. Keine echte Hardware wird verändert.','Original simplified models: gates, execution and boot sequence. No actual hardware is changed.')}</p><label><input type="checkbox" data-bit-a /> A = 1</label><label><input type="checkbox" data-bit-b /> B = 1</label><svg viewBox="0 0 500 110" role="img" aria-label={t('Halbaddierer: A und B speisen XOR für Summe und AND für Übertrag','Half adder: A and B feed XOR for sum and AND for carry')}><path d="M20 25H180M20 85H180M180 25L250 35M180 85L250 35M180 25L250 80M180 85L250 80M350 35H480M350 80H480" stroke="currentColor" fill="none"/><rect x="250" y="15" width="100" height="35" fill="#d8e5ff"/><rect x="250" y="65" width="100" height="35" fill="#d8e5ff"/><text x="270" y="39" fill="#17213a">XOR</text><text x="270" y="89" fill="#17213a">AND</text></svg><output data-gates role="status"></output><h3>{t('CPU schrittweise verstehen','Step through CPU execution')}</h3><p>LOAD 5 → ADD 3 → STORE → HALT</p><ol class="lab-flow"><li data-cpu-phase="0">Fetch</li><li data-cpu-phase="1">Decode</li><li data-cpu-phase="2">Execute</li></ol><output data-cpu-output role="status"></output><div class="practice-actions"><button class="button primary" data-cpu-step>{t('Ein Schritt','Step')}</button><button class="button secondary" data-cpu-play>{t('Abspielen / Pause','Play / pause')}</button><button class="button secondary" data-cpu-reset>{t('Neustart','Restart')}</button><label>{t('Schrittdauer','Step duration')}<select data-cpu-speed><option value="1000">1 s</option><option value="500">0.5 s</option><option value="2000">2 s</option></select></label></div><h3>{t('Booten: Hardware trifft Software','Booting: hardware meets software')}</h3><ol><li>{t('Firmware initialisiert die Plattform','Firmware initialises the platform')}</li><li>{t('UEFI-Bootmanager wählt einen Loader','UEFI boot manager selects a loader')}</li><li>{t('Loader startet das Betriebssystem','Loader starts the operating system')}</li><li>{t('Kernel und Treiber stellen Ressourcen bereit','Kernel and drivers provide resources')}</li><li>{t('Anwendung verarbeitet Eingaben','Application processes input')}</li></ol></section>:topic==='spieleentwicklung'&&<section id="labor" class="practice-lab" data-game-lab><h2>{t('Spiele-Labor: Punkte sammeln','Game lab: collect points')}</h2><p>{t('Fokussiere das Spielfeld und benutze Pfeiltasten oder die Schaltflächen. Eine Eingabe bewegt die Figur um einen festen Modellschritt. Sammle den gelben Punkt; die Wand ist fest.','Focus the field and use arrow keys or the buttons. Each input moves the character one fixed model step. Collect the yellow point; the wall is solid.')}</p><svg class="lab-scene" tabindex="0" viewBox="0 0 400 220" role="group" aria-label={t('Spielfeld mit Pfeiltasten bedienen; Tab verlässt das Feld','Game field: use arrow keys; Tab leaves the field')}><rect x="180" y="45" width="30" height="130" fill="#64748b"/><rect data-player x="20" y="100" width="20" height="20" fill="#526dff"/><circle data-coin cx="350" cy="110" r="8" fill="#eab308"/></svg><div class="lab-keys"><button data-move="up" aria-label={t('Nach oben','Move up')}>↑</button><button data-move="left" aria-label={t('Nach links','Move left')}>←</button><button data-move="down" aria-label={t('Nach unten','Move down')}>↓</button><button data-move="right" aria-label={t('Nach rechts','Move right')}>→</button><button data-game-reset>{t('Neustart','Restart')}</button></div><output data-game-status role="status"></output><h3>{t('Eigenes Godot-Projekt','Original Godot project')}</h3><p>{t('Entpacke das Archiv in einen eigenen Ordner, importiere project.godot in Godot 4.5 und starte mit F5. Pfeiltasten bewegen, die Schaltfläche startet neu.','Extract the archive to a separate folder, import project.godot in Godot 4.5 and run with F5. Arrow keys move; the button restarts.')}</p><a class="button secondary" href="/downloads/pixel-lab.zip" download>{t('Godot-Projekt herunterladen','Download Godot project')}</a></section>}
<script src="../scripts/labs.ts"></script>
