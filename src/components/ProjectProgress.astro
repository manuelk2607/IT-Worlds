---
import {projectMilestones} from '../data/project-milestones.ts';
import {translate,type Locale} from '../lib/locale.ts';
interface Props{id:string;locale:Locale}
const {id,locale}=Astro.props;const t=translate(locale);const steps=projectMilestones[id]??[];
---
<section class="project-progress container" data-project-progress={id} aria-labelledby="project-progress-heading"><h2 id="project-progress-heading">{t('Deine Projektcheckliste','Your project checklist')}</h2><p>{t('Hake einen Schritt erst ab, wenn du ihn selbst ausgeführt und das angegebene Ergebnis geprüft hast. Dies ist eine Selbsteinschätzung, keine automatische Abnahme. Der Stand bleibt auf diesem Gerät, auch ohne Account; er wird nicht mit deinem Konto synchronisiert.','Check a step only after performing it and verifying its expected result yourself. This is self-assessment, not automatic acceptance. Progress stays on this device even without an account; it does not synchronise with your account.')}</p><p data-project-count role="status"></p><progress data-project-meter max={steps.length} value="0" aria-label={t('Selbst bestätigte Projektschritte','Self-confirmed project steps')}></progress><ol>{steps.map(step=><li><label><input type="checkbox" disabled data-project-step={step.id}/><span>{step.title[locale]}</span></label> <a href={`#${step.id}`}>{t('Schritt öffnen','Open step')}</a></li>)}</ol><a class="button primary" data-project-resume href={`#${steps[0]?.id??'inhalt'}`}>{t('Projekt beginnen','Start project')}</a> <button disabled class="button secondary" data-project-reset>{t('Checkliste zurücksetzen','Reset checklist')}</button> <button hidden class="button secondary" data-project-undo>{t('Zurücksetzen rückgängig','Undo reset')}</button><p data-project-save role="status"></p></section>
<script src="../scripts/project-progress.ts"></script>
<style>.project-progress{border:1px solid var(--line);border-radius:14px;padding:1.5rem;margin-block:1.5rem}.project-progress progress{width:100%;accent-color:var(--blue)}.project-progress ol{padding-left:1.3rem}.project-progress li{margin:.8rem 0}.project-progress label{display:inline-flex;align-items:center;gap:.7rem;min-height:44px}.project-progress input{width:1.2rem;height:1.2rem;flex-shrink:0}.project-progress li a{display:inline-block;margin-left:.7rem}.project-progress .button{margin-top:.6rem;max-width:100%;white-space:normal}</style>
