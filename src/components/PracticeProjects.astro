---
import {practiceProjects} from '../data/practice-projects.ts';
import {translate,localePath,type Locale} from '../lib/i18n.ts';
interface Props {locale:Locale}const {locale}=Astro.props;const t=translate(locale);
---
<section class="container section"><h2>{t('Größere Praxisprojekte','Larger practice projects')}</h2><p>{t('Verbinde mehrere Kursthemen in einem vollständigen lokalen Projekt mit Referenzdateien, Fehlerfällen und tatsächlichen Tests.','Connect several course topics in a complete local project with reference files, failure cases and actual tests.')}</p><div class="catalog-grid">{practiceProjects.map(project=><article class="progress-entry"><h3>{project.title[locale]}</h3><p>{project.description[locale]}</p><a class="button secondary" href={localePath(locale,project.path)}>{t('Praxisprojekt öffnen →','Open practice project →')}</a></article>)}</div></section>
