---
import {typingLessons} from '../lib/typing.ts';
import {translate,localePath,type Locale} from '../lib/i18n.ts';
import '../styles/practice.css';
interface Props {locale:Locale}
const {locale}=Astro.props;const t=translate(locale);
const rows=['^1234567890ß´','qwertzuiopü+','asdfghjklöä#','<yxcvbnm,.-'];
---
<section class="practice-lab typing-trainer" data-typing-trainer aria-labelledby="trainer-title">
 <h2 id="trainer-title">{t('Dein Schreibtrainer','Your typing trainer')}</h2>
 <p>{t('Übe frei ohne Anmeldung. Standardisierte 60-Sekunden-Tests und Kontospeicherung ergänzen deine Übungen. Die Tastatur zeigt eine Lernzuordnung, keine erfasste Handhaltung.','Practise freely without signing in. Standardised 60-second tests and account storage complement practice. The keyboard shows a teaching map, not detected hand position.')}</p>
 <div class="catalog-toolbar"><label>{t('Lektion','Lesson')}<select data-typing-lesson>{typingLessons.map(l=><option value={l.id}>{l[locale]}</option>)}</select></label><label>{t('Modus','Mode')}<select data-typing-mode><option value="practice">{t('Übung · 60 Sekunden','Practice · 60 seconds')}</option><option value="ranked">{t('Ranglistentest · 60 Sekunden','Ranked test · 60 seconds')}</option></select></label><label class="practice-check"><input type="checkbox" checked data-typing-hints />{t('Tastaturhinweise','Keyboard hints')}</label></div>
 <label data-custom-label hidden>{t('Eigener Übungstext · bleibt lokal','Custom practice text · stays local')}<textarea maxlength="1000" data-typing-custom rows="3"></textarea></label>
 <div class="practice-actions"><button class="button primary" data-typing-start>{t('Starten','Start')}</button><button class="button secondary" data-typing-stop disabled>{t('Beenden','Finish')}</button><button class="button secondary" data-typing-reset>{t('Zurücksetzen','Reset')}</button></div>
 <p data-typing-status role="status"></p><p class="typing-target" data-typing-target aria-label={t('Abzuschreibender Text','Text to type')}></p>
 <label>{t('Hier schreiben · Korrekturen am Textende','Type here · corrections at the end')}<textarea data-typing-input rows="3" disabled spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" aria-describedby="typing-help"></textarea></label>
 <p id="typing-help">{t('Tab verlässt das Feld. Backspace korrigiert, frühere Fehler bleiben gezählt. Im Ranglistentest sind Einfügen, Ersetzen, IME und Fokusverlust nicht zulässig; nutze dafür freie Übungen.','Tab leaves the field. Backspace corrects text while earlier errors remain counted. Ranked tests do not allow paste, replacement, IME or loss of focus; use practice for those inputs.')}</p>
 <dl class="typing-metrics" aria-live="off"><div><dt>{t('Restzeit','Time left')}</dt><dd data-typing-time>60 s</dd></div><div><dt>WPM</dt><dd data-typing-wpm>0</dd></div><div><dt>{t('Anschläge/min','Characters/min')}</dt><dd data-typing-kpm>0</dd></div><div><dt>{t('Genauigkeit','Accuracy')}</dt><dd data-typing-accuracy>0 %</dd></div><div><dt>{t('Fehlerquote','Error rate')}</dt><dd data-typing-errors>0 %</dd></div></dl>
 <div class="typing-keyboard" data-typing-keyboard aria-label="QWERTZ">{rows.map(row=><div>{Array.from(row).map(key=><span data-typing-key={key}>{key}</span>)}</div>)}<div><span data-typing-key=" " class="space-key">{t('Leertaste · Daumen','Space · thumbs')}</span></div></div><p data-finger-hint></p>
 <details id="wertung"><summary>{t('Wertung und Grenzen','Scoring and limitations')}</summary><p>{t('Ein Normwort zählt fünf Zeichen. Netto-WPM = korrekt verbleibende Zeichen / 5 / Minuten. Anschläge/min zählen alle druckbaren Eingaben. Genauigkeit = richtige druckbare Eingaben / alle druckbaren Eingaben. Fehlerquote = 100 % minus Genauigkeit. Ein expliziter Start eröffnet das Messfenster. Ranglisten vergleichen je Sprache denselben Text und volle 60 Sekunden, ohne Hilfen; frühes Beenden zählt nicht.','A standard word has five characters. Net WPM = correctly retained characters / 5 / minutes. Characters/min counts all printable inputs. Accuracy = correct printable inputs / all printable inputs. Error rate = 100% minus accuracy. An explicit start opens the timing window. Rankings compare the same text per language for a full 60 seconds, without hints; early completion is not ranked.')}</p><p>{t('Serverzeit, Ereignis-Replay, Plausibilitätsgrenzen und einmalige Abgabe erschweren Manipulationen. Browserereignisse beweisen weder einen Menschen noch verwendete Finger. Ergebnisse sind Lernwerte, kein Zertifikat. Eigene Texte werden nicht hochgeladen.','Server timing, event replay, plausibility bounds and single submission deter manipulation. Browser events prove neither a human nor fingers used. Results are learning measures, not a certificate. Custom texts are not uploaded.')}</p></details>
 <h3>{t('Deine lokalen Ergebnisse','Your local results')}</h3><p data-typing-best></p><svg class="typing-chart" viewBox="0 0 400 100" role="img" aria-label={t('WPM der letzten Übungen, chronologisch','WPM of recent practice, chronological')}><path d="M10 90H390M10 10V90" stroke="currentColor" fill="none"/><polyline data-typing-chart fill="none" stroke="var(--blue)" stroke-width="3" /></svg><p data-typing-history></p><p data-typing-weakness></p>
 <details><summary>{t('Konto und öffentliche Rangliste','Account and public leaderboard')}</summary><p>{t('Konto-Ergebnisse bleiben privat. Veröffentliche nur einen frei gewählten Anzeigenamen, keinen Klarnamen oder eine E-Mail-Adresse. Deine Sichtbarkeit kannst du jederzeit abschalten.','Account results remain private. Publish a chosen display name, not a real name or email. You can disable visibility at any time.')}</p><a href={localePath(locale,'/konto/')}>{t('Anmelden / Account erstellen','Sign in / create account')}</a><label>{t('Anzeigename','Display name')}<input data-typing-name maxlength="24" autocomplete="off" /></label><label class="practice-check"><input type="checkbox" data-typing-public />{t('Meine bestätigten Testwerte öffentlich anzeigen','Show my confirmed test results publicly')}</label><button class="button secondary" data-typing-profile>{t('Sichtbarkeit speichern','Save visibility')}</button><p data-typing-account role="status"></p><div class="catalog-toolbar"><label>{t('Zeitraum · UTC','Period · UTC')}<select data-ranking-period><option value="day">{t('Heute','Today')}</option><option value="week">{t('Diese Woche','This week')}</option><option value="month">{t('Dieser Monat','This month')}</option><option value="all">{t('Gesamt','All time')}</option></select></label><label>{t('Sortieren','Sort')}<select data-ranking-metric><option value="wpm">WPM</option><option value="kpm">{t('Anschläge/min','Characters/min')}</option><option value="accuracy">{t('Genauigkeit','Accuracy')}</option></select></label><button class="button secondary" data-ranking-load>{t('Rangliste laden','Load leaderboard')}</button></div><p data-ranking-status role="status"></p><ol data-ranking-list></ol></details>
</section>
<script src="../scripts/typing.ts"></script>
