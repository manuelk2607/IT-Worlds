---
import CodeExample from './CodeExample.astro';
import Layout from '../layouts/Layout.astro';
import LearningRoute from './LearningRoute.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SourceCard from './SourceCard.astro';
import {practiceTools} from '../data/practice-topics.ts';
import ProgressToggle from './ProgressToggle.astro';
import ExerciseLinks from './ExerciseLinks.astro';
import { courses, coursePath, chapterProgressId } from '../data/courses.ts';
import { isTypesettingCourse, courseCatalogTopic, TYPESETTING_TOPIC_PATH, typesettingTopic } from '../data/topic-categories.ts';
import {practiceProjects} from '../data/practice-projects.ts';
import {glossary} from '../data/glossary.ts';
import type { Course, Chapter } from '../data/course-types.ts';
import { getContent, translate, localePath, type Locale } from '../lib/i18n.ts';
import katex from 'katex';
import 'katex/dist/katex.min.css';
import '../styles/courses.css';
interface Props { locale?: Locale; course: Course; chapter?: Chapter }
const { course, chapter, locale = 'de' } = Astro.props;
const t = translate(locale);
const { levels, levelName, topicById } = getContent(locale);
const position = chapter ? course.chapters.findIndex(item => item.id === chapter.id) : -1;
const previous = course.chapters[position - 1];
const next = course.chapters[position + 1];
const title = chapter ? chapter.title[locale] : course.title[locale] + t(' · Kursübersicht', ' · Course overview');
const description = chapter ? chapter.goals.map(goal => goal[locale]).join(' ') + ' ' + course.title[locale] + '.' : course.description[locale];
const quizUrl = localePath(locale, `/quiz/?kurs=${course.id}${chapter ? `&kapitel=${chapter.id}` : ''}`);
const defaults: Partial<Record<Course['id'],Course['id']>>={ki:'latex',latex:'ki',datenbanken:'apis',apis:'datenbanken',typescript:'apis'};
const related=(course.related ?? (defaults[course.id]?[defaults[course.id]!]:[])).map(id=>courses.find(item=>item.id===id)).filter((item):item is Course=>!!item);
const other=related[0];
const typesetting=isTypesettingCourse(course);
const catalogTopic=courseCatalogTopic(course);
const parentTitle=typesetting?typesettingTopic(locale).title:topicById(course.topic)!.title;
const parentPath=typesetting?TYPESETTING_TOPIC_PATH:`/themen/${course.topic}/`;
const breadcrumbRoot=typesetting?{title:t('Themenwelten','Topics'),href:'/#themenwelten'}:{title:t('Kurse','Courses'),href:'/lernpfade/'};
---
<Layout locale={locale} title={title} description={description} active={typesetting?'themen':'pfade'}>
  <Breadcrumbs locale={locale} items={[breadcrumbRoot,{title:parentTitle,href:parentPath}, ...(chapter ? [{title:course.title[locale],href:coursePath(course)},{title:chapter.title[locale]}] : [{title:course.title[locale]}])]} />
  <header class="container page-top course-header">
    <a class="back-link" href={localePath(locale, chapter ? coursePath(course) : parentPath)}>{t('← Zur Übersicht', '← Back to overview')}</a>
    <p class="eyebrow">{parentTitle} · {typesetting ? t('TEXTSATZSYSTEM', 'TYPESETTING SYSTEM') : t('LERNKURS', 'LEARNING COURSE')}</p>
    <h1>{title}</h1>
    {glossary.some(term=>term.topic===catalogTopic)&&<p><a class="text-link" href={localePath(locale,`/glossar/?thema=${catalogTopic}`)}>{t('Begriffe im Glossar nachschlagen →','Look up terms in the glossary →')}</a></p>}
    {!chapter && <p class="page-lead">{description}</p>}
    <div class="course-meta">
      <span>{chapter ? levelName(chapter.level) : t('Einstieg → Vertiefung → Profi', 'Beginner → Intermediate → Advanced')}</span>
      <span>{chapter?t(`Kapitel ${position+1} von ${course.chapters.length}`,`Chapter ${position+1} of ${course.chapters.length}`):t(`${course.chapters.length} Kapitel`, `${course.chapters.length} chapters`)}</span>
      <span>{t('Ohne Anmeldung zugänglich', 'Accessible without signing in')}</span>
    </div>
  </header>
  <div class="container course-layout">
    <aside class="course-sidebar">
      <details open data-course-outline>
        <summary>{t('Kursinhalt', 'Course contents')}</summary>
        <nav aria-label={t('Kapitelnavigation', 'Chapter navigation')}>
          <a href={localePath(locale, coursePath(course))} aria-current={!chapter ? 'page' : undefined}>{t('Überblick & Voraussetzungen', 'Overview & prerequisites')}</a>
          {course.chapters.map(item => <a href={localePath(locale, coursePath(course, item))} aria-current={chapter?.id === item.id ? 'page' : undefined}>{item.title[locale]}<small>{levelName(item.level)}</small></a>)}
        </nav>
      </details>
    </aside>
    <div class="course-content">
      {practiceProjects.filter(project=>project.courses.includes(course.id)&&(!chapter||chapter.id==='abschluss')).map(project=><section class="prerequisite"><div><h2>{project.title[locale]}</h2><p>{project.description[locale]}</p><a class="button secondary" href={localePath(locale,project.path)}>{t('Vollständiges Praxisprojekt öffnen →','Open the complete practice project →')}</a></div></section>)}
      {['typst','latex'].includes(course.id) && <section class="prerequisite"><div><h2>{t('Dokumente selbst erstellen und prüfen','Create and check your own documents')}</h2><p>{t('Bearbeite dein Projekt extern und lade die Quellen zur Prüfung. IT-Worlds prüft lokal ausgewählte Muster und Aufgabenmerkmale. Kompiliere und kontrolliere das PDF im externen Editor.','Edit externally and load the sources for checking. IT-Worlds checks selected patterns and task constructs locally. Compile and review the PDF in the external editor.')}</p><p><a class="button primary" href={course.id==='latex'?'https://www.overleaf.com/':'https://typst.app/'} target="_blank" rel="noopener noreferrer">{course.id==='latex'?t('In Overleaf bearbeiten ↗','Edit in Overleaf ↗'):t('In typst.app bearbeiten ↗','Edit in typst.app ↗')}</a> <a class="button secondary" href={localePath(locale,`/dokumentpruefung/?format=${course.id}${chapter?`&aufgabe=${chapterProgressId(course,chapter)}`:''}`)}>{t('Projekt prüfen →','Check project →')}</a> <a class="text-link" href={localePath(locale,'/textsatz/')}>{t('Typst & LaTeX vergleichen','Compare Typst & LaTeX')}</a></p></div></section>}
      {!chapter ? <>
        <LearningRoute locale={locale} steps={course.chapters.map(chapter=>({id:chapterProgressId(course,chapter),title:chapter.title[locale],url:coursePath(course,chapter)}))}/>
        <section class="prerequisite"><div><h2>{t('Dein Einstieg', 'Your starting point')}</h2><p>{course.prerequisites[locale]}</p><p>{t('Arbeite die Kapitel in Reihenfolge durch. Lies die Erklärung, rechne oder führe das Beispiel aus und löse die Aufgabe vor dem Öffnen der Lösung. Die Quizfragen prüfen anschließend dein Verständnis.', 'Work through the chapters in order. Read the explanation, calculate or run the example, and solve the exercise before opening its solution. The quiz then checks your understanding.')}</p></div></section>
        {levels.map(level => <section class="course-stage"><h2>{level.name}</h2><ol class="course-chapters">{course.chapters.filter(item => item.level === level.id).map(item => <li><a href={localePath(locale, coursePath(course, item))}><h3>{item.title[locale]}</h3><p>{item.goals.map(goal => goal[locale]).join(' ')}</p><span class="text-link">{t('Kapitel öffnen →', 'Open chapter →')}</span></a></li>)}</ol></section>)}
        <ExerciseLinks locale={locale} course={course.id} />
        <a class="button primary" href={quizUrl}>{t('Kursquiz starten', 'Start course quiz')}</a>
      </> : <>
        <article id="einstiegsartikel" class="course-article">
          <div class="course-prerequisite"><strong>{t('Voraussetzung:', 'Prerequisite:')}</strong> {previous ? <a href={localePath(locale, coursePath(course, previous))}>{previous.title[locale]}</a> : course.prerequisites[locale]}</div>
          <section class="course-goals"><h2>{t('Nach diesem Kapitel kannst du …', 'After this chapter you can …')}</h2><ul>{chapter.goals.map(goal => <li>{goal[locale]}</li>)}</ul></section>
          <nav class="chapter-toc" aria-label={t('In diesem Kapitel', 'In this chapter')}><strong>{t('In diesem Kapitel', 'In this chapter')}</strong>{chapter.sections.map((section, index) => <a href={`#abschnitt-${index + 1}`}>{section.title[locale]}</a>)}<a href="#aufgabe">{t('Aufgabe & Lösung', 'Exercise & solution')}</a><a href="#belege">{t('Quellen & Vertiefung', 'Sources & further reading')}</a></nav>
          {chapter.sections.map((section, index) => <section class="course-section" id={`abschnitt-${index + 1}`}><h2>{section.title[locale]}</h2>{section.paragraphs.map(paragraph => <p>{paragraph[locale]}</p>)}
            {section.formula && <div class="course-formula" tabindex="0" aria-label={t('Mathematische Formel', 'Mathematical formula')} set:html={katex.renderToString(section.formula, { displayMode: true, throwOnError: true, trust: false, output: 'htmlAndMathml' })} />}
            {section.code && <CodeExample code={section.code} language={section.language} locale={locale} label={section.runtime==='browser'?t('Im Browser ausführen','Run in a browser'):section.runtime==='node'?t('Mit Node.js ausführen','Run with Node.js'):t('Vollständiges Beispiel','Complete example')}/>}
            {section.code&&['Typst','LaTeX'].includes(section.language??'')&&['latex','typst'].includes(course.id)&&<p><a class="button secondary" href={localePath(locale,`/dokumentpruefung/?format=${course.id}&aufgabe=${chapterProgressId(course,chapter)}&beispiel=${course.id}-${chapter.id}-${index}`)}>{t('Dieses Beispiel lokal prüfen →','Check this example locally →')}</a></p>}
          </section>)}
          <section id="aufgabe" class="course-exercise"><p class="eyebrow">{t('SELBST ANWENDEN', 'APPLY IT YOURSELF')}</p><h2>{t('Deine Aufgabe', 'Your exercise')}</h2><p>{chapter.exercise[locale]}</p>{['latex','typst'].includes(course.id)&&<p><a class="button primary" href={course.id==='latex'?'https://www.overleaf.com/':'https://typst.app/'} target="_blank" rel="noopener noreferrer">{course.id==='latex'?t('Aufgabe in Overleaf bearbeiten ↗','Work on the task in Overleaf ↗'):t('Aufgabe in typst.app bearbeiten ↗','Work on the task in typst.app ↗')}</a> <a class="button secondary" href={localePath(locale,`/dokumentpruefung/?format=${course.id}&aufgabe=${chapterProgressId(course,chapter)}`)}>{t('Exportierte Quellen prüfen →','Check exported sources →')}</a></p>}<details><summary>{t('Lösung & Begründung anzeigen', 'Show solution & reasoning')}</summary><p>{chapter.solution[locale]}</p></details></section>
          <ExerciseLinks locale={locale} course={course.id} chapter={chapter.id} />
          <ProgressToggle locale={locale} kind="lesson" contentId={chapterProgressId(course, chapter)} />
          <a class="button primary" href={quizUrl}>{t('Dieses Kapitel im Quiz prüfen', 'Test this chapter in the quiz')} →</a>
          <section id="belege" class="course-sources"><h2>{t('Quellen & Vertiefung', 'Sources & further reading')}</h2><p class="muted">{t('Die angegebenen Abschnitte dienen als Belege und als weiterführende Lektüre. Fassung und Lesedatum stehen bei jedem Beleg. Ein unabhängiges Fachreview steht aus.', 'The listed sections provide evidence and further reading. Each source records its edition and reading date. Independent expert review is pending.')}</p>{chapter.sources.map(id => <SourceCard locale={locale} id={id} compact />)}</section>
        </article>
        <nav class="course-pagination" aria-label={t('Weiterlernen', 'Continue learning')}>
          {previous && <a class="button secondary" href={localePath(locale, coursePath(course, previous))}>← {previous.title[locale]}</a>}
          {next ? <a class="button primary" href={localePath(locale, coursePath(course, next))}>{next.title[locale]} →</a> : other ? <a class="button primary" href={localePath(locale, coursePath(other))}>{t('Abschlussprojekt verbinden:', 'Connect the final project:')} {other.title[locale]} →</a> : <a class="button primary" href={localePath(locale,'/lernpfade/')}>{t('Weiteren Kurs wählen →','Choose another course →')}</a>}
        </nav>
      </>}
      {practiceTools.filter(tool=>tool.topic===course.topic).map(tool=><p><a class="button secondary" href={localePath(locale,tool.url)}>{tool.title[locale]} →</a></p>)}
      <p class="course-review muted">{t('Die Kursfolge behandelt Grundlagen bis zu fortgeschrittenen Entscheidungen und Projekten. Sie ist kein Zertifikat und ersetzt keine eigenständige Praxis oder fachliche Begutachtung.', 'The course sequence covers foundations through advanced decisions and projects. It is not a certificate and does not replace independent practice or expert assessment.')}</p>
    </div>
  </div>
  <script src="../scripts/course.ts"></script>
</Layout>

