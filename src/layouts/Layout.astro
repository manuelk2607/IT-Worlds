---
import { getContent, translate, localePath, type Locale } from "../lib/i18n";
const locale: Locale = Astro.props.locale ?? "de";
const t = translate(locale);
const { topics, paths } = getContent(locale);
import "../styles/global.css";
import "../styles/preferences.css";
import { pageSeo } from "../lib/seo";
import Icon from "../components/Icon.astro";
import ts from "typescript";
import themeInit from "../scripts/theme-init.ts?raw";
import { switchLocalePath } from "../lib/i18n";
const themeBoot = ts.transpileModule(themeInit, { compilerOptions: { target: ts.ScriptTarget.ES2022 } }).outputText;

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  active?: string;
}
const pageDescriptions: Record<string,string> = {
  '/quiz/': t('Zehn IT-Quizfragen mit Erklärungen zu jeder Antwort und offiziellen Quellen. Teste dein Wissen ohne Anmeldung und ohne Zeitdruck.', 'Ten IT quiz questions with explanations for every answer and official sources. Test your knowledge without an account or time pressure.'),
  '/quellen/': t('19 offizielle IT-Quellen mit Herausgeber, Version, Abschnitt und Lesedatum. Prüfe die Belege hinter unseren Lerntexten und Übungen.', '19 official IT sources with publisher, version, section and reading date. Check the evidence behind our articles and exercises.'),
  '/lernpfade/': t('Drei IT-Lernpfad-Skizzen mit Voraussetzungen und ehrlicher Kennzeichnung verfügbarer und geplanter Inhalte.', 'Three IT learning-path sketches with prerequisites and clear labels for available and planned content.'),
};
const basePath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const {
  title = t("IT verstehen. Deine Welt erweitern.", "Understand IT. Expand your world."),
  description = pageDescriptions[basePath] ?? t("Entdecke zehn IT-Themenwelten, Lernwege vom Einstieg bis zum Profi und erste Quizfragen mit nachvollziehbaren Primärquellen.", "Explore ten IT topics, learning paths from beginner to advanced and introductory quizzes with traceable primary sources."),
  active = "",
} = Astro.props;
const seo = pageSeo(Astro.url.pathname,locale,title,description);
const nav = [
  { label: t("Entdecken", "Explore"), href: "/", id: "home" },
  { label: t("Themenwelten", "Topics"), href: "/#themenwelten", id: "themen" },
  { label: t("Lernpfade", "Learning paths"), href: "/lernpfade/", id: "pfade" },
  { label: t("Übungen", "Practice"), href: "/uebungen/", id: "uebungen" },
  { label: t("Wissensquiz", "Quiz"), href: "/quiz/", id: "quiz" },
  { label: t("Quellen", "Sources"), href: "/quellen/", id: "quellen" },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeBoot}></script>
    <link rel="alternate" hreflang="de" href={new URL(Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/", "https://it-worlds.maki26.workers.dev").href} />
    <link rel="alternate" hreflang="en" href={new URL(locale === "en" ? Astro.url.pathname : `/en${Astro.url.pathname}`, "https://it-worlds.maki26.workers.dev").href} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="9W8XeJ15-XfHaf0VmyCKn7QGze-upbYIM-X3Kk_LPwo" />
    <link rel="canonical" href={seo.canonical} />
    <link rel="alternate" hreflang="x-default" href={seo.languages.de} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="robots" content={seo.noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IT-Worlds" />
    <meta property="og:title" content={title + " | IT-Worlds"} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:locale" content={locale === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'de' ? 'en_GB' : 'de_DE'} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('IT-Worlds: IT verstehen und selbst ausprobieren', 'IT-Worlds: understand IT and try it yourself')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title + " | IT-Worlds"} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={seo.image} />
    {!seo.noindex && <script is:inline type="application/ld+json" set:html={seo.structuredData}></script>}
    <meta name="theme-color" content="#f7f8fc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | IT-Worlds</title>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">
      {t("Zum Inhalt springen", "Skip to content")}
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={localePath(locale, "/")} aria-label={t("IT-Worlds – Startseite", "IT-Worlds – Home")}>
          <span class="brand-symbol">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </span>
          IT<span class="brand-hyphen">-</span>Worlds
          <span class="brand-period">.</span>
        </a>
        <nav class="desktop-nav" aria-label={t("Hauptnavigation", "Main navigation")}>
          {nav.map((item) => (
            <a
              href={localePath(locale, item.href)}
              data-nav-id={item.id}
              class:list={{ active: active === item.id }}
              aria-current={active === item.id ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
          <span class="nav-indicator" aria-hidden="true"></span>
        </nav>
        <div class="header-actions">
          <button
            class="search-trigger"
            data-open-search
            aria-label={t("Suchen – Website durchsuchen", "Search the website")}
          >
            <Icon name="search" size={19} />
            <span>{t("Suchen", "Search")}</span>
            <kbd aria-hidden="true">/</kbd>
          </button>
          <a href={localePath(locale, "/konto/")} class="header-cta" data-account-link>{t("Anmelden", "Sign in")}</a>
          <a class="locale-switch" href={switchLocalePath(Astro.url.pathname)} data-language-switch hreflang={locale === "de" ? "en" : "de"} lang={locale === "de" ? "en" : "de"} aria-label={t("Switch to English", "Zu Deutsch wechseln")}>{locale === "de" ? "EN" : "DE"}</a>
          <button class="theme-toggle icon-button" data-theme-toggle aria-label={t("Dunkles Design aktivieren", "Switch to dark mode")} aria-pressed="false"><span data-theme-icon aria-hidden="true">◐</span></button>
          <button
            class="mobile-menu-button"
            aria-label={t("Menü öffnen", "Open menu")}
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <nav
        id="mobile-nav"
        class="mobile-nav"
        aria-label={t("Mobile Hauptnavigation", "Mobile main navigation")}
        hidden
      >
        {nav.map((item) => (
          <a href={localePath(locale, item.href)} data-nav-id={item.id} class:list={{ active: active === item.id }} aria-current={active === item.id ? "page" : undefined}>{item.label}</a>
        ))}
      <a href={localePath(locale, "/fortschritt/")}>{t("Mein Lernstand", "My progress")}</a>
        <a href={localePath(locale, "/konto/")}>{t("Mein Account", "My account")}</a>
      </nav>
    </header>
    <main id="inhalt">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <a class="brand" href={localePath(locale, "/")}>
            IT-Worlds<span class="brand-period">.</span>
          </a>
          <p>{t("Wissen verbindet. Neugier bringt dich weiter.", "Knowledge connects. Curiosity takes you further.")}</p>
        </div>
        <div class="footer-links">
          <a href={localePath(locale, "/#themenwelten")}>{t("Themenwelten", "Topics")}</a>
          <a href={localePath(locale, "/lernpfade/")}>{t("Lernpfade", "Learning paths")}</a>
          <a href={localePath(locale, "/quellen/")}>{t("Quellen & Qualität", "Sources & quality")}</a>
          <a
            href="https://github.com/manuelk2607/IT-Worlds"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t("Auf GitHub mitwirken ↗", "Contribute on GitHub ↗")}
          </a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>{t("Ein wachsendes Lernprojekt. Offen für deine Neugier.", "A growing learning project. Open to your curiosity.")}</span>
        <span>{t("Erster Website-Entwurf · Inhalte im Aufbau", "First website draft · Content in progress")}</span>
      </div>
    </footer>
    <dialog id="search-dialog" aria-labelledby="search-title">
      <div class="search-dialog-head">
        <h2 id="search-title">{t("Was möchtest du verstehen?", "What would you like to understand?")}</h2>
        <button
          class="icon-button"
          data-close-search
          aria-label={t("Suche schließen", "Close search")}
        >
          <Icon name="close" />
        </button>
      </div>
      <label for="global-search" class="sr-only">
        {t("Themen und Lernpfade durchsuchen", "Search topics and learning paths")}
      </label>
      <div class="search-field">
        <Icon name="search" size={21} />
        <input
          id="global-search"
          type="search"
          placeholder={t("Zum Beispiel Python, SQL oder KI …", "For example Python, SQL or AI …")}
          autocomplete="off"
        />
      </div>
      <p class="search-help">{t("Themenwelten & Lernpfade durchsuchen", "Search topics & learning paths")}</p>
      <div id="search-results" aria-live="polite">
        {topics.map((topic) => (
          <a
            href={localePath(locale, `/themen/${topic.id}/`)}
            data-search-item
            data-search-text={`${topic.title} ${topic.tags.join(" ")} ${Object.values(topic.curriculum).flat().join(" ")}`.toLocaleLowerCase(locale)}
          >
            <span class={`search-result-icon color-${topic.color}`}>
              <Icon name={topic.icon} size={19} />
            </span>
            <span>
              {topic.title}
              <small>{t("Themenwelt · Einstieg bis Profi", "Topic · Beginner to advanced")}</small>
            </span>
            <Icon name="arrow" size={17} />
          </a>
        ))}
        {paths.map((path) => (
          <a
            href={localePath(locale, `/lernpfade/${path.id}/`)}
            data-search-item
            data-search-text={`${t("lernpfad", "learning path")} ${path.title} ${path.description}`.toLocaleLowerCase(locale)}
          >
            <span class="search-result-icon">
              <Icon name="book" size={19} />
            </span>
            <span>
              {path.title}
              <small>{t("Lernpfad", "Learning path")}</small>
            </span>
            <Icon name="arrow" size={17} />
          </a>
        ))}
      </div>
      <p id="search-empty" hidden>
        {t("Keine Treffer. Versuche einen Begriff wie „Python“, „Linux“ oder „Website“.", "No results. Try a term such as “Python”, “Linux” or “website”.")}
      </p>
    </dialog>
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/progress-client.ts"></script>
  </body>
</html>
