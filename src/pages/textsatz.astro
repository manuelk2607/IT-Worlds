---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import {localePath,translate,type Locale} from '../lib/i18n.ts';
import {courses,coursePath} from '../data/courses.ts';
import '../styles/documents.css';
interface Props {locale?:Locale}
const locale=Astro.props.locale??'de';const t=translate(locale);
const typst=courses.find(c=>c.id==='typst')!,latex=courses.find(c=>c.id==='latex')!;
---
<Layout locale={locale} title={t('Textsatz lernen: Typst und LaTeX','Learn typesetting: Typst and LaTeX')} description={t('Strukturierte Dokumente mit Typst und LaTeX erstellen: Kurse, Lernziele, Vergleich und lokale Projektprüfung.','Create structured documents with Typst and LaTeX: courses, learning goals, comparison and local project checks.')} active="textsatz">
 <Breadcrumbs locale={locale} items={[{title:t('Programmiersprachen','Programming languages'),href:'/themen/programmiersprachen/'},{title:t('Auszeichnungs- & Satzsprachen','Markup & typesetting')}]}/>
 <header class="container page-top"><p class="eyebrow">{t('AUSZEICHNUNGS- & SATZSPRACHEN','MARKUP & TYPESETTING')}</p><h1>{t('Vom Inhalt zur klaren Publikation','From content to a clear publication')}</h1><p class="page-lead">{t('Typst und LaTeX sind programmierbare Textsatzsysteme: Du beschreibst Bedeutung, Struktur und Gestaltungsregeln; ein Compiler erzeugt die Ausgabe. Wähle nach Ziel und Anforderungen.','Typst and LaTeX are programmable typesetting systems: describe meaning, structure and styling rules; a compiler produces the output. Choose by purpose and requirements.')}</p></header>
 <section class="container section typesetting-grid" aria-label={t('Textsatzkurse','Typesetting courses')}>
  {[typst,latex].map(course=><article class="document-panel"><p class="eyebrow">{course.id==='typst'?t('EMPFOHLENER EINSTIEG OHNE VORWISSEN','SUGGESTED START WITHOUT PRIOR EXPERIENCE'):t('BEWÄHRTES TEX-ÖKOSYSTEM','ESTABLISHED TEX ECOSYSTEM')}</p><h2>{course.title[locale]}</h2><p>{course.description[locale]}</p><p>{t(`${course.chapters.length} Kapitel · Übungen · erklärtes Quiz`,`${course.chapters.length} chapters · exercises · explained quiz`)}</p><a class="button primary" href={localePath(locale,coursePath(course))}>{t('Kurs öffnen','Open course')} →</a></article>)}
 </section>
 <section class="container section"><h2>{t('Welches Werkzeug passt zu deinem Dokument?','Which tool fits your document?')}</h2><div class="table-scroll" tabindex="0" role="region" aria-label={t('Vergleich Typst und LaTeX','Typst and LaTeX comparison')}>
  <table class="typesetting-comparison"><caption>{t('Entscheidungshilfe; keine pauschale Qualitäts- oder Geschwindigkeitsrangliste','Decision guide; not a universal quality or speed ranking')}</caption><thead><tr><th>{t('Kriterium','Criterion')}</th><th>Typst</th><th>LaTeX</th></tr></thead><tbody>
   <tr><th>{t('Syntax & Einstieg','Syntax & starting out')}</th><td>{t('Markup mit =, Code mit #, Mathematik mit $. Eine integrierte Skriptsprache für Funktionen und Daten.','Markup with =, code with #, math with $. An integrated scripting language for functions and data.')}</td><td>{t('Makros mit Backslash und Argumentgruppen; Präambel, Dokumentklasse und Pakete. Vertraute Vorlagen helfen beim Einstieg.','Backslash macros and argument groups; preamble, class and packages. Familiar templates help you get started.')}</td></tr>
   <tr><th>{t('Zusammenarbeit & Vorschau','Collaboration & preview')}</th><td>{t('Offizielle Web-App mit Vorschau; freier lokaler Compiler. Projektarchiv für den Wechsel exportieren.','Official web app with preview; free local compiler. Export a project archive to move between them.')}</td><td>{t('Overleaf oder lokale TeX-Installation. Compiler und Literaturwerkzeug müssen zu den Paketen passen.','Overleaf or a local TeX installation. Compiler and bibliography tool must match the packages.')}</td></tr>
   <tr><th>{t('Einsatz & Abhängigkeiten','Use & dependencies')}</th><td>{t('Berichte, wissenschaftliche Dokumente und datengetriebene Vorlagen. Prüfe, ob die verlangte Publikationsvorlage verfügbar ist.','Reports, scientific documents and data-driven templates. Check availability of the required publication template.')}</td><td>{t('Breites Paket- und Verlagsvorlagen-Ökosystem. Eine verbindliche LaTeX-Vorlage kann die Wahl bereits bestimmen.','Broad package and publisher-template ecosystem. A mandatory LaTeX template can determine the choice.')}</td></tr>
   <tr><th>{t('Performance & Kontrolle','Performance & control')}</th><td>{t('Inkrementelle Builds bei Änderungen; miss das eigene Projekt mit festen Compiler-, Font- und Paketversionen.','Incremental builds on changes; benchmark your own project with fixed compiler, font and package versions.')}</td><td>{t('Zusätzliche Läufe können für Verweise und Literatur nötig sein. Vergleiche identische Inhalte und vollständige Buildketten.','Additional passes may be needed for references and bibliography. Compare identical content and complete build chains.')}</td></tr>
  </tbody></table></div>
  <p><a href="https://typst.app/docs/guides/for-latex-users/" target="_blank" rel="noopener noreferrer">{t('Offizieller Wechselguide ↗','Official migration guide ↗')}</a> · <a href="https://www.latex-project.org/help/documentation/" target="_blank" rel="noopener noreferrer">{t('LaTeX-Dokumentation ↗','LaTeX documentation ↗')}</a></p>
 </section>
 <section class="container section"><h2>{t('Ein gemeinsamer Projektweg','A shared project route')}</h2><ol><li>{t('Lerne Dokumentstruktur, Mathematik, Tabellen und Literatur im gewählten Kurs.','Learn structure, mathematics, tables and bibliography in your chosen course.')}</li><li>{t('Erstelle einen eigenen Bericht in Overleaf (LaTeX) oder typst.app (Typst). Trenne Inhalt, Vorlage und Ressourcen.','Create your own report in Overleaf (LaTeX) or typst.app (Typst). Separate content, template and resources.')}</li><li>{t('Exportiere das vollständige Projekt, prüfe es hier und verbessere es anhand der Befunde.','Export the complete project, check it here and improve it using the findings.')}</li><li>{t('Kontrolliere das PDF im externen Editor, Quellen und Lernziele; übertrage erst dann deinen Lernfortschritt.','Review the PDF in the external editor, references and learning goals; only then record your learning progress.')}</li></ol><p><a class="button primary" href={localePath(locale,'/dokumentpruefung/')}>{t('Projektprüfung öffnen →','Open project check →')}</a></p><p>{t('Markdown eignet sich ergänzend für einfache strukturierte Texte wie README-Dateien. Es bleibt im selben Unterbereich; der Typst-/LaTeX-Vergleich ersetzt keine automatische Konvertierung.','Markdown complements these tools for simple structured texts such as README files. It remains in the same subcategory; this comparison does not automatically convert documents.')} <a href={localePath(locale,'/themen/programmiersprachen/markdown/')}>{t('Markdown lernen →','Learn Markdown →')}</a></p></section>
</Layout>
