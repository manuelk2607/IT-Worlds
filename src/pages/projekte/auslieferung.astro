---
import ProjectProgress from '../../components/ProjectProgress.astro';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CodeExample from '../../components/CodeExample.astro';
import SourceCard from '../../components/SourceCard.astro';
import {deliveryProject,deliveryFiles} from '../../data/practice-projects.ts';
import {translate,localePath,type Locale} from '../../lib/i18n.ts';
import '../../styles/courses.css';
import '../../styles/projects.css';
interface Props {locale?:Locale}
const locale=Astro.props.locale??'de';const t=translate(locale);
const files=deliveryFiles.map(name=>({name,url:`/projekte/auslieferung/${name}`}));
---
<Layout locale={locale} title={deliveryProject.title[locale]} description={deliveryProject.description[locale]} active="uebungen">
 <Breadcrumbs locale={locale} items={[{title:t('Übungen','Practice'),href:'/uebungen/'},{title:deliveryProject.title[locale]}]}/>
 <header class="container page-top"><p class="eyebrow">{t('EIN DIENST · EIN VERTRAG · ECHTE ANFRAGEN','ONE SERVICE · ONE CONTRACT · REAL REQUESTS')}</p><h1>{deliveryProject.title[locale]}</h1><p class="page-lead">{deliveryProject.description[locale]}</p><p>{t('Voraussetzungen: Node.js ab 22.22, zwei Terminals und die Kursgrundlagen zu HTTP, TypeScript und Tests. Kein Konto und keine zusätzlichen Pakete erforderlich.','Prerequisites: Node.js 22.22 or later, two terminals, and course foundations in HTTP, TypeScript and tests. No account or additional packages required.')}</p><a class="button primary" href="/downloads/auslieferung.zip" download>{t('Vollständiges Projekt herunterladen','Download the complete project')}</a></header>
 <ProjectProgress id="auslieferung" locale={locale}/>
 <article class="container section course-article project-article">
  <nav class="chapter-toc" aria-label={t('Projektschritte','Project steps')}><a href="#start">{t('1 · Starten','1 · Start')}</a><a href="#vertrag">{t('2 · Vertrag','2 · Contract')}</a><a href="#fehler">{t('3 · Fehler provozieren','3 · Introduce faults')}</a><a href="#tests">{t('4 · Automatisieren','4 · Automate')}</a><a href="#abnahme">{t('5 · Abnehmen','5 · Accept')}</a><a href="#quellen">{t('Quellen','Sources')}</a></nav>
  <section id="start"><h2>{t('1 · Einen echten lokalen Dienst starten','1 · Start a real local service')}</h2><p>{t('Entpacke das Projekt in einen neuen Übungsordner. Starte im ersten Terminal den enthaltenen Dienst. Er hört nur auf deinem Rechner unter Port 8810 und verändert keine Dateien oder Konten. Öffne die Adresse im Browser und prüfe die sichtbare Überschrift. Beende nur deinen eigenen Prozess mit Ctrl-C.','Extract the project into a new practice folder. Start the included service in the first terminal. It listens only on your machine on port 8810 and changes no files or accounts. Open the address in a browser and check the visible heading. Stop only your own process with Ctrl-C.')}</p><CodeExample locale={locale} language="Shell" code={'node --experimental-strip-types serve.ts\n# http://127.0.0.1:8810/'} label={t('Terminal 1 · im entpackten Projekt','Terminal 1 · inside the extracted project')}/></section>
  <section id="vertrag"><h2>{t('2 · Einen überprüfbaren Vertrag festlegen','2 · Define a testable contract')}</h2><p>{t('Lies check.ts, bevor du den Prüfer im zweiten Terminal startest. Er erwartet vier konkrete Routen: HTML-Startseite mit festgelegter Überschrift, JSON-Gesundheitsantwort, typgeprüften Kurskatalog und eine fehlende Route mit echtem 404. Ein Status 200 allein genügt nicht.','Read check.ts before starting the checker in the second terminal. It expects four specific routes: an HTML homepage with an agreed heading, a JSON health response, a type-checked course catalog and a missing route with a real 404. Status 200 alone is insufficient.')}</p><CodeExample locale={locale} language="Shell" code={'node --experimental-strip-types cli.ts http://127.0.0.1:8810/'} label={t('Terminal 2 · vier PASS-Zeilen erwartet','Terminal 2 · expect four PASS lines')}/><p>{t('Exitcode 0 bedeutet: alle vier Prüfungen bestanden. 1 bedeutet: mindestens ein Vertragsfehler. 2 bedeutet: ungültiger Aufruf oder ungültige Konfiguration. Einträge aus fremden Antworten werden als unknown behandelt und durch Bedingungen geprüft.','Exit code 0 means all four checks passed. 1 means at least one contract failure. 2 means invalid invocation or configuration. Entries in external responses are treated as unknown and validated with actual conditions.')}</p></section>
  <section id="fehler"><h2>{t('3 · Fehler gezielt nachweisen und beheben','3 · Demonstrate and fix faults')}</h2><p>{t('Stoppe den eigenen Dienst und starte ihn mit jeweils einer Fehlerart neu. Sage vor jedem Prüflauf voraus, welche Route scheitern muss. Vergleiche deine Erwartung mit dem Ergebnis. Verwende dafür ausschließlich den enthaltenen Übungsdienst.','Stop your own service and restart it with one fault at a time. Predict which route must fail before each check. Compare your prediction with the result. Use only the included learning service for fault injection.')}</p><CodeExample locale={locale} language="Shell" code={'node --experimental-strip-types serve.ts missing\n# Terminal 2:\nnode --experimental-strip-types cli.ts http://127.0.0.1:8810/'} label={t('Erwarte FAIL für missing route und Exitcode 1','Expect FAIL for missing route and exit code 1')}/><dl>{[['status',t('Startseite liefert 500.','Homepage returns 500.')],['type',t('Startseite liefert den falschen Inhaltstyp.','Homepage has the wrong content type.')],['content',t('HTML enthält die falsche Überschrift.','HTML contains the wrong heading.')],['schema',t('JSON enthält falsche Feldtypen.','JSON has incorrect field types.')],['missing',t('Fehlende Route liefert irreführend 200.','Missing route misleadingly returns 200.')],['redirect',t('Eine Weiterleitung wird abgewiesen.','A redirect is rejected.')],['oversize',t('Die Antwort überschreitet 64 KiB.','Response exceeds 64 KiB.')],['slow',t('Der Dienst antwortet nach einer Sekunde; der separate Test setzt 50 ms als Grenze.','The service replies after one second; the separate test sets a 50 ms limit.')]].map(([name,detail])=><div><dt><code>{name}</code></dt><dd>{detail}</dd></div>)}</dl><details><summary>{t('Lösung und Begründung','Solution and reasoning')}</summary><p>{t('Jede Fehlerart muss an der betroffenen Route mindestens ein FAIL erzeugen. Die unabhängigen übrigen Routen sollen weiter geprüft werden. Bei schema darf ein HTTP 200 mit JSON-Syntax keinen falschen Datentyp verdecken. Bei missing muss der tatsächliche Status geprüft werden. Starte anschließend ohne Fehlerparameter neu: Erst vier PASS-Zeilen bestätigen den wiederhergestellten Vertrag.','Each fault must produce at least one FAIL at its route. Independent remaining routes must still be checked. For schema, HTTP 200 and JSON syntax must not conceal an incorrect data type. For missing, check the actual status. Finally restart without a fault argument: only four PASS lines confirm the restored contract.')}</p></details></section>
  <section id="tests"><h2>{t('4 · Automatisierung mit echten HTTP-Anfragen','4 · Automate real HTTP requests')}</h2><CodeExample locale={locale} language="Shell" code={'node --experimental-strip-types --test check.test.ts'} label={t('Automatisierte Prüfungen · kein manuell laufender Dienst nötig','Automated checks · no manually running service needed')}/><p>{t('Die Tests starten jeweils einen eigenen Dienst auf einem freien lokalen Port und schließen ihn anschließend. Sie prüfen Erfolg, sieben Fehlerarten, ein echtes Timeout und ungültige Konfiguration. Lies fixture und finally: Auch ein fehlschlagender Test muss seinen eigenen Dienst aufräumen. Der Prüfer begrenzt Zeit und Antwortgröße, sendet nur GET ohne Zugangsdaten und folgt keinen Weiterleitungen.','Tests start their own service on a free local port and close it afterwards. They verify success, seven faults, a real timeout and invalid configuration. Read fixture and finally: a failing test must also clean up its own service. The checker bounds time and body size, sends only GET without credentials and follows no redirects.')}</p><p>{t('Deine Transferaufgabe: Ergänze zunächst einen fehlschlagenden Test für eine leere Kursliste. Erweitere danach den Demonstrationsdienst um diesen Fehler und lasse ihn durch den bestehenden Prüfer erkennen. Das Soll-Ergebnis ist ein FAIL für catalog bei weiterhin bestandenem health.','Your transfer task: first add a failing test for an empty course list. Then extend the demo service with this fault and let the existing checker detect it. Expect FAIL for catalog while health still passes.')}</p><details><summary>{t('Transferlösung prüfen','Check the transfer solution')}</summary><p>{t('Nimm einen neuen Fehlerbezeichner in Fault und faults auf und liefere bei /api/courses für diesen Fall [] zurück. Ergänze den Fall im negativen HTTP-Test. Die vorhandene Vertragsregel data.length > 0 muss ihn bereits ablehnen; diese Regel zu entfernen würde den Testzweck umgehen.','Add a new fault name to Fault and faults, and return [] for /api/courses in that case. Add the case to the negative HTTP test. The existing data.length > 0 contract rule must already reject it; removing that rule would defeat the test.')}</p></details></section>
  <section id="abnahme"><h2>{t('5 · Eine vollständige Abnahme dokumentieren','5 · Document complete acceptance')}</h2><ul><li>{t('Halte Node-Version, Projektstand, Vertrag und ausgeführte Befehle fest.','Record Node version, project version, contract and executed commands.')}</li><li>{t('Zeige den erfolgreichen Grundlauf sowie Fehler, Diagnose und anschließende erfolgreiche Wiederherstellung.','Show the successful baseline, fault, diagnosis and successful recovery.')}</li><li>{t('Erkläre, warum HTML-200, gültiges JSON und ein grüner health-Endpunkt jeweils nur einen Teil des Vertrags belegen.','Explain why HTML 200, valid JSON and a green health endpoint each establish only part of the contract.')}</li><li>{t('Prüfe die Browserausgabe selbst. Für einen späteren öffentlichen Dienst prüfe zusätzlich dessen eigene DNS-/TLS-Auslieferung und Nutzerwege. Passe vorher den Vertrag an den tatsächlichen Dienst an.','Inspect the browser output yourself. For a later public service, additionally check its own DNS/TLS delivery and user journeys. First adapt the contract to that actual service.')}</li><li>{t('Beende ausschließlich den eigenen Übungsdienst. Dieses Projekt migriert keine Daten und führt kein Cloudflare-Rollback aus; Code-Rückkehr und Datenwiederherstellung sind getrennte Aufgaben.','Stop only your own learning service. This project migrates no data and performs no Cloudflare rollback; returning to earlier code and restoring data are separate tasks.')}</li></ul><p><a class="text-link" href={localePath(locale,'/themen/cloud-devops/kurs/abschluss/')}>{t('Im Cloud-/DevOps-Kurs weiterlernen →','Continue in the Cloud/DevOps course →')}</a> · <a href={localePath(locale,'/quiz/?kurs=devops')}>{t('Verständnis im Kursquiz prüfen →','Test understanding in the course quiz →')}</a></p></section>
  <section><h2>{t('Einzeldateien und vollständige Referenz','Individual files and complete reference')}</h2><ul>{files.map(file=><li><a href={file.url} download>{file.name}</a></li>)}</ul><p>{t('Der vollständige Referenzcode ist offen einsehbar. Bearbeite die Transferaufgabe zuerst selbst und nutze die Tests als Abnahmekriterien.','The complete reference source is available. Try the transfer task yourself first and use the tests as acceptance criteria.')}</p></section>
  <section id="quellen"><h2>{t('Quellen und Vertiefung','Sources and further reading')}</h2>{deliveryProject.sources.map(id=><SourceCard id={id} locale={locale} compact/>)}</section>
 </article>
</Layout>
