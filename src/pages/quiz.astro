---
import { getContent, translate, localePath, type Locale } from "../lib/i18n";
const locale: Locale = Astro.props.locale ?? "de";
const t = translate(locale);
const { questions, topics, levels, levelName, topicById, sources } = getContent(locale);
import { courses, courseChapters, coursePath } from '../data/courses.ts';
import '../styles/courses.css';
interface Props { locale?: Locale }
import ProgressToggle from "../components/ProgressToggle.astro";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

---

<Layout locale={locale} title={t("Wissensquiz", "Knowledge quiz")} active="quiz">
  <section class="container page-top page-intro quiz-intro">
    <p class="eyebrow">{t("NEUGIER AN. ZEITDRUCK AUS.", "CURIOSITY ON. TIME PRESSURE OFF.")}</p>
    <h1>
      {t("Ein kleines Quiz.", "A little quiz.")}
      <br />
      {t("Ein neues", "A new")} <span>{t("Aha.", "discovery.")}</span>
    </h1>
    <p class="page-lead">
      {t(`${questions.length} erklärte Fragen. Starte mit zehn Fragen oder passe Thema, Kurs, Lernstufe und Rundenlänge an. Ohne Zeitlimit und ohne Anmeldung.`, `${questions.length} explained questions. Start with ten or choose a topic, course, level and round length. No time limit or account required.`)}
    </p>
  </section>
  <section class="container narrow quiz-section">
    <details class="quiz-filter-panel"><summary>{t('Quiz anpassen: Filter & Rundenlänge','Customise quiz: filters & round length')}</summary>
    <div class="quiz-controls course-filters">
      <label for="quiz-topic">{t("Deine Themenwahl", "Your topic")}
      <select id="quiz-topic">
        <option value="alle">{t("Alle Themenwelten", "All topics")}</option>
        {topics.map((topic) => (
          <option value={topic.id}>
            {topic.title}
          </option>
        ))}
      </select></label>
      <label for="quiz-course">{t('Kurs', 'Course')}<select id="quiz-course"><option value="alle">{t('Alle Kurse & Einstiegsfragen', 'All courses & introductory questions')}</option>{courses.map(course => <option value={course.id} data-topic={course.topic}>{course.title[locale]}</option>)}</select></label>
      <label for="quiz-level">{t('Lernstufe', 'Level')}<select id="quiz-level"><option value="alle">{t('Alle Lernstufen', 'All levels')}</option>{levels.map(level => <option value={level.id}>{level.name}</option>)}</select></label>
      <label for="quiz-chapter">{t('Kapitel', 'Chapter')}<select id="quiz-chapter"><option value="alle">{t('Alle Kapitel', 'All chapters')}</option>{courseChapters.map(({ course, chapter, id }) => <option value={id} data-course={course.id} data-chapter={chapter.id} data-level={chapter.level}>{course.title[locale]} · {chapter.title[locale]}</option>)}</select></label>
      <button type="button" id="clear-quiz-filters" class="text-link">{t('Filter zurücksetzen', 'Clear filters')}</button>
    </div>
    <div class="quiz-round-controls">
      <label for="quiz-size">{t('Fragen pro Runde','Questions per round')}<select id="quiz-size"><option value="5">5</option><option value="10" selected>10</option><option value="20">20</option><option value="alle">{t('Alle passenden Fragen','All matching questions')}</option></select></label>
      <label class="quiz-shuffle"><input type="checkbox" id="quiz-shuffle" />{t('Fragen zufällig mischen','Shuffle questions')}</label>
    </div>
    <div class="quiz-personal-controls">
      <label for="quiz-review-state">{t('Gespeicherter Lernstand','Saved learning state')}<select id="quiz-review-state" disabled aria-describedby="quiz-personal-status"><option value="alle">{t('Alle Fragen','All questions')}</option><option value="offen">{t('Noch nicht bearbeitet','Not practised yet')}</option><option value="wiederholen">{t('Bearbeitet · noch nicht richtig','Practised · not yet correct')}</option><option value="richtig">{t('Richtig beantwortet','Answered correctly')}</option></select></label>
      <p id="quiz-personal-status" class="muted" role="status">{t('Persönliche Filter sind mit einem optionalen Account verfügbar.','Personal filters are available with an optional account.')}</p>
      <a id="quiz-personal-login" class="text-link" href={localePath(locale,'/konto/')}>{t('Optional anmelden →','Sign in optionally →')}</a>
    </div>
    </details>
    <p id="quiz-selection-summary" class="quiz-selection-summary"></p>
    <p id="quiz-pool-status" class="muted" role="status">{t('Deine Fragerunde wird vorbereitet.','Preparing your question round.')}</p>
    <div class="quiz-shell">
      <p id="quiz-empty" role="status" tabindex="-1" hidden>{t('Keine Fragen für diese Kombination. Ändere die Filter oder setze sie zurück.', 'No questions match this combination. Change or clear the filters.')}</p>
      <button id="clear-quiz-review" class="text-link" hidden>{t('Alle Fragen dieser Auswahl üben →','Practise all questions in this selection →')}</button>
      <div id="quiz-progress" hidden>
        <div>
          <span id="question-count">{t(`Frage 1 von ${questions.length}`, `Question 1 of ${questions.length}`)}</span>
          <span>{t("Ohne Zeitlimit", "No time limit")}</span>
        </div>
        <progress
          id="question-progress"
          value="0"
          max={questions.length}
          aria-label={t("Beantwortete Fragen", "Questions answered")}
        ></progress>
      </div>
      <div id="quiz-questions">
        {questions.map((question) => (
          <section
            data-question={question.id}
            data-review-href={localePath(locale, question.course ? coursePath(courses.find(course=>course.id===question.course)!, courseChapters.find(item=>item.id===`${question.course}-${question.chapter}`)!.chapter) : `/themen/${question.topic}/`)}
            data-topic={question.topic}
            data-course={question.course ?? ''}
            data-level={question.level}
            data-chapter={question.course ? `${question.course}-${question.chapter}` : ''}
            hidden
          >
            <span class="quiz-topic-label">
              {topicById(question.topic)!.title}{" "}
              <span class="dot-separator">·</span> {levelName(question.level)}
            </span>
            {question.course && (() => { const course = courses.find(course => course.id === question.course)!; const chapter = course.chapters.find(chapter => chapter.id === question.chapter)!; return <p><a class="text-link" href={localePath(locale, coursePath(course, chapter))}>{t('Kapitel nachlesen:', 'Read the chapter:')} {chapter.title[locale]} →</a></p>; })()}
            <form data-quiz-form data-answer={question.answer}>
              <fieldset>
                <legend>{question.prompt}</legend>
                <div class="answer-options">
                  {question.options.map((option, optionIndex) => (
                    <label class="answer-option">
                      <input
                        type="radio"
                        name={question.id}
                        value={optionIndex}
                        required
                      />
                      <span class="option-letter">
                        {String.fromCharCode(65 + optionIndex)}
                      </span>
                      <span>{option.text}</span>
                      <span class="option-marker" aria-hidden="true"></span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <button type="submit" class="button primary check-answer">
                {t("Antwort prüfen", "Check answer")} <Icon name="arrow" size={18} />
              </button>
              <div class="quiz-feedback" role="status" hidden>
                <strong class="feedback-heading"></strong>
                {question.options.map((option, optionIndex) => (
                  <p data-explanation={optionIndex} hidden>
                    <strong>{String.fromCharCode(65 + optionIndex)} · {option.text}: </strong>{option.explanation}
                  </p>
                ))}
                <a
                  class="feedback-source"
                  href={sources[question.source].url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {t("Beleg:", "Source:")} {sources[question.source].publisher} ·{" "}
                  {sources[question.source].section} ↗
                  <span class="sr-only"> {t("(neuer Tab)", "(new tab)")}</span>
                </a>
              </div>
              <button type="button" class="button primary next-question" hidden>
                {t("Nächste Frage", "Next question")} <Icon name="arrow" size={18} />
              </button>
            </form>
            <ProgressToggle locale={locale} kind="question" contentId={question.id} />
            <p class="quiz-footnote">
              {t("Grundlage:", "Based on:")} {sources[question.source].version} · {t("Quellenabgleich:", "Sources checked:")}
              {sources[question.source].reviewedAt}
            </p>
            <details class="no-js-solution">
              <summary>{t("Lösung und Erklärungen", "Answer and explanations")}</summary>
              {question.options.map((option, index) => (
                <p><strong>{index === question.answer ? t('Richtig: ', 'Correct: ') : ''}{option.text}: </strong>{option.explanation}</p>
              ))}
              <a href={sources[question.source].url}>{t("Originalquelle", "Original source")}</a>
            </details>
          </section>
        ))}
      </div>
      <section id="quiz-result" hidden>
        <span class="result-icon">
          <Icon name="spark" size={38} />
        </span>
        <p class="eyebrow">{t("JEDES AHA ZÄHLT", "EVERY DISCOVERY COUNTS")}</p>
        <h2 tabindex="-1">{t("Dein nächster Schritt beginnt hier.", "Your next step starts here.")}</h2>
        <p id="quiz-score" role="status"></p>
        <p>
          {t("Ein kurzes Quiz zeigt einen Ausschnitt. Du kannst die Grundlagen nachlesen oder eine andere Themenwelt ausprobieren.", "A short quiz offers a glimpse. Read the foundations or try another topic.")}
        </p>
        <section id="quiz-review" class="quiz-review" hidden><h3>{t('Gezielt nachlesen und wiederholen','Read and practise what you missed')}</h3><ul id="quiz-review-list"></ul></section>
        <div class="result-actions">
          <button class="button primary" id="restart-quiz">
            {t("Dieselbe Runde wiederholen", "Repeat this round")} <Icon name="arrow" size={18} />
          </button>
          <button class="button secondary" id="new-quiz-round">{t('Neue zufällige Runde','New shuffled round')}</button>
          <a class="text-link" href={localePath(locale, "/#themenwelten")}>
            {t("Themen entdecken →", "Explore topics →")}
          </a>
        </div>
      </section>
    </div>
    <p class="quiz-note">
      <Icon name="book" size={17} />
      {t('Quellenbasierte Fragen mit Erklärungen zu jeder Option. Ein unabhängiges Fachreview steht aus. Kein Zertifikat oder Gesamturteil über deine Kompetenz.', 'Source-based questions with explanations for every option. Independent expert review is pending. No certificate or overall judgement of your skills.')}
    </p>
    <noscript>
      <style>
        [data-question][hidden] {
          display: block !important;
          margin-top: 2rem;
        }
        .no-js-solution {
          display: block;
        }
        .check-answer,
        .quiz-controls,
        .quiz-round-controls,
        .quiz-personal-controls,
        .quiz-filter-panel,
        #quiz-selection-summary,
        #quiz-pool-status,
        #quiz-progress {
          display: none;
        }
      </style>
      <p>
        {t("Für die interaktive Auswertung aktiviere JavaScript. Alle Fragen, Lösungen und Quellen kannst du auch hier lesen.", "Enable JavaScript for interactive feedback. You can still read all questions, answers and sources here.")}
      </p>
    </noscript>
  </section>
  <script src="../scripts/quiz.ts"></script>
</Layout>
