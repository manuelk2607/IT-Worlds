---
import { getContent, translate, localePath, type Locale } from "../../lib/i18n";
const locale: Locale = Astro.props.locale ?? "de";
const t = translate(locale);
const { topicById, levelName } = getContent(locale);
import ProgressToggle from "../../components/ProgressToggle.astro";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { paths as staticPaths, type LearningPath } from "../../data/content";
export function getStaticPaths() {
  return staticPaths.map((path) => ({ params: { slug: path.id }, props: { path } }));
}
interface Props { locale?: Locale; path: LearningPath }
const { path } = Astro.props;
const available = path.steps.filter((step) => step.available).length;
---

<Layout locale={locale} title={path.title} description={path.description} active="pfade">
  <section class="container page-top">
    <a href={localePath(locale, "/lernpfade/")} class="back-link">
      {t("← Alle Lernpfade", "← All learning paths")}
    </a>
    <div class={`topic-page-header color-${path.color}`}>
      <span class="large-topic-icon">
        <Icon name={path.icon} size={36} />
      </span>
      <p class="eyebrow">
        {t('DEIN LERNPFAD', 'YOUR LEARNING PATH')} · {path.course ? t('EINSTIEG BIS PROFI', 'BEGINNER TO ADVANCED') : levelName(path.level).toLocaleUpperCase(locale)}
      </p>
      <h1>{path.title}</h1>
      <p class="page-lead">{path.description}</p>
      <p class="availability">
        <span class="status-dot"></span>
        {t(`${available} von ${path.steps.length} Schritten aktuell verfügbar`, `${available} of ${path.steps.length} steps currently available`)}
      </p>
    </div>
  </section>
  <div class="container narrow section">
    <section class="prerequisite">
      <Icon name="spark" />
      <div>
        <h2>{t("Deine Voraussetzungen", "Your prerequisites")}</h2>
        <p>{path.prerequisites}</p>
      </div>
    </section>
    <h2>{t("Dein Lernweg Schritt für Schritt.", "Your learning route step by step.")}</h2>
    <p class="muted">
      {path.course ? t("Alle Kapitel sind verfügbar. Starte mit dem ersten Schritt oder öffne gezielt ein Kapitel.", "Every chapter is available. Begin at the first step or open a specific chapter.") : t("Verfügbare Einstiege kannst du direkt öffnen. Die übrigen Schritte zeigen den geplanten Ausbau.", "Open the available introductions directly. The remaining steps show planned additions.")}
    </p>
    <ol class="path-steps">
      {path.steps.map((step, index) => (
        <li>
          <span class="step-number">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <span class="step-topic">{topicById(step.topic)!.title}</span>
            <h3>{step.title}</h3>
            {step.available ? (
              <a
                class="text-link"
                href={localePath(locale, step.href ?? `/themen/${step.topic}/#einstiegsartikel`)}
              >
                {t("Lektion lesen", "Read lesson")} <Icon name="arrow" size={17} />
              </a>
              <ProgressToggle locale={locale} kind="lesson" contentId={step.contentId ?? step.topic} />
            ) : (
              <>
                <span class="planned-badge">{t("In Planung", "Planned")}</span>
                <a class="planned-topic-link" href={localePath(locale, `/themen/${step.topic}/`)}>
                  {t("Themenplan ansehen →", "View topic outline →")}
                </a>
              </>
            )}
          </div>
        </li>
      ))}
    </ol>
    <div class="editorial-note">
      <Icon name="book" />
      <p>
        {path.course ? t('Alle Kapitel dieses Kurses sind verfügbar, einschließlich Aufgaben, Lösungen und Quiz. Der freiwillige Account speichert deinen Fortschritt.', 'All chapters of this course are available, including exercises, solutions and quizzes. The optional account saves your progress.') : t('Dies ist eine Lernweg-Skizze mit verfügbaren Einstiegen und geplanten Schritten. Geplante Inhalte zählen nicht als abgeschlossen.', 'This is a learning-path outline with available introductions and planned steps. Planned content is not counted as completed.')}
      </p>
    </div>
    <a href={localePath(locale, path.course ? `/quiz/?kurs=${path.course}` : '/quiz/')} class="button primary">
      {t("Erste Quizfragen ausprobieren", "Try the first quiz questions")} <Icon name="arrow" size={18} />
    </a>
  </div>
</Layout>
