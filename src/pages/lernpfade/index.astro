---
import {getContent,translate,localePath,type Locale} from '../../lib/i18n.ts';
import {courses} from '../../data/courses.ts';
import Layout from '../../layouts/Layout.astro';
import CourseCard from '../../components/CourseCard.astro';
interface Props {locale?:Locale}
const locale=Astro.props.locale??'de';const t=translate(locale);const {paths,topics}=getContent(locale);
const outlines=paths.filter(path=>!path.course);
---
<Layout locale={locale} title={t('Kurse & Lernpfade','Courses & learning paths')} active="pfade">
 <header class="container page-top"><p class="eyebrow">{t('SCHRITT FÜR SCHRITT','STEP BY STEP')}</p><h1>{t('Finde deinen Lernweg.','Find your learning route.')}</h1><p class="page-lead">{t('Beginne mit einem verfügbaren Kurs. Jedes Kapitel enthält Erklärungen, eine Aufgabe mit Lösung und Quizfragen.','Start with an available course. Every chapter includes explanations, an exercise with solution and quiz questions.')}</p><nav class="section-shortcuts" aria-label={t('Auf dieser Seite','On this page')}><a href="#kurse">{t('Verfügbare Kurse','Available courses')}</a><a href="#lernpfade">{t('Weitere Lernpfade','Other learning paths')}</a><a href={localePath(locale,'/lernen/')}>{t('Hilfe beim Einstieg','Help getting started')}</a></nav></header>
 <section class="container section" id="kurse"><h2>{t('Direkt loslernen','Start learning now')}</h2><p>{t('Alle folgenden Kurse sind vom Einstieg bis zu fortgeschrittenen Aufgaben ausgearbeitet. Wähle ein Thema; die Kapitel selbst sind nach Lernstufe geordnet.','All courses below cover foundations through advanced exercises. Choose a topic; chapters themselves are organised by level.')}</p><div class="catalog-toolbar"><label for="course-search">{t('Kurs suchen','Search courses')}<input id="course-search" type="search" placeholder={t('Titel oder Thema …','Title or topic …')}/></label><label for="course-topic">{t('Themenwelt','Topic')}<select id="course-topic"><option value="alle">{t('Alle Themenwelten','All topics')}</option>{topics.filter(topic=>courses.some(course=>course.topic===topic.id)).map(topic=><option value={topic.id}>{topic.title}</option>)}</select></label><button id="reset-course-filter" class="button secondary">{t('Zurücksetzen','Reset')}</button></div><p id="course-count" role="status">{t(`${courses.length} Kurse verfügbar`,`${courses.length} courses available`)}</p><div class="catalog-grid">{courses.map(course=><CourseCard course={course} locale={locale} heading="h3"/>)}</div><p id="courses-empty" hidden>{t('Keine Kurse für diese Auswahl. Suche kürzen oder Filter zurücksetzen.','No courses match this selection. Shorten your search or reset the filters.')}</p></section>
 <section class="container section" id="lernpfade"><h2>{t('Themen verbinden','Connect topics')}</h2><p>{t('Diese älteren Lernpfade beschreiben übergreifende Ziele. Einige Schritte sind noch geplant und ausdrücklich markiert. Für einen durchgehend verfügbaren Kurs nutze die Auswahl oben.','These earlier learning paths describe broader goals. Some steps are still planned and explicitly marked. For a fully available course use the selection above.')}</p><div class="outline-grid">{outlines.map(path=><article class="outline-card"><span class="planned-badge">{t('Teilweise geplant','Partly planned')}</span><h3><a href={localePath(locale,`/lernpfade/${path.id}/`)}>{path.title}</a></h3><p>{path.description}</p><p>{t(`${path.steps.filter(step=>step.available).length} von ${path.steps.length} Schritten verfügbar`,`${path.steps.filter(step=>step.available).length} of ${path.steps.length} steps available`)}</p><a class="text-link" href={localePath(locale,`/lernpfade/${path.id}/`)}>{t('Lernpfad ansehen →','View learning path →')}</a></article>)}</div></section>
 <script src="../../scripts/paths.ts"></script>
</Layout>
