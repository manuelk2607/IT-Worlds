---
import Exercises from '../uebungen.astro';
import Typesetting from '../textsatz.astro';
import DocumentCheck from '../../components/DocumentCheck.astro';
import CourseView from '../../components/CourseView.astro';
import { courses } from '../../data/courses.ts';
import type { Course, Chapter } from '../../data/course-types.ts';
import Home from '../index.astro';
import Start from '../lernen.astro';
import Quiz from '../quiz.astro';
import Sources from '../quellen.astro';
import Paths from '../lernpfade/index.astro';
import Path from '../lernpfade/[slug].astro';
import Topic from '../themen/[slug].astro';
import Account from '../konto.astro';
import Progress from '../fortschritt.astro';
import NotFound from '../404.astro';
import { topics, paths } from '../../data/content.en';
import type { Topic as TopicData, LearningPath } from '../../data/content';
interface Props { view: string; topic?: TopicData; path?: LearningPath; course?: Course; chapter?: Chapter }
export function getStaticPaths() {
  return [
    ...courses.flatMap(course => [
      { params: { page: `themen/${course.topic}/${course.slug}` }, props: { view: 'course', course } },
      ...course.chapters.map(chapter => ({ params: { page: `themen/${course.topic}/${course.slug}/${chapter.id}` }, props: { view: 'course', course, chapter } })),
    ]),
    ...[undefined, 'lernen', 'quiz', 'uebungen', 'quellen', 'lernpfade', 'konto', 'fortschritt', '404', 'textsatz', 'dokumentpruefung'].map(page => ({ params: { page }, props: { view: page ?? 'home' } })),
    ...topics.map(topic => ({ params: { page: `themen/${topic.id}` }, props: { view: 'topic', topic } })),
    ...paths.map(path => ({ params: { page: `lernpfade/${path.id}` }, props: { view: 'path', path } })),
  ];
}
const { view, topic, path, course, chapter } = Astro.props;
---
{view === 'home' && <Home locale="en" />}
{view === 'lernen' && <Start locale="en" />}
{view === 'textsatz' && <Typesetting locale="en" />}
{view === 'dokumentpruefung' && <DocumentCheck locale="en" />}
{view === 'course' && course && <CourseView locale="en" course={course} chapter={chapter} />}
{view === 'uebungen' && <Exercises locale="en" />}
{view === 'quiz' && <Quiz locale="en" />}
{view === 'quellen' && <Sources locale="en" />}
{view === 'lernpfade' && <Paths locale="en" />}
{view === 'konto' && <Account locale="en" />}
{view === 'fortschritt' && <Progress locale="en" />}
{view === '404' && <NotFound locale="en" />}
{view === 'topic' && topic && <Topic locale="en" topic={topic} />}
{view === 'path' && path && <Path locale="en" path={path} />}
