---
import { getContent, translate, localePath, type Locale } from "../../lib/i18n";
const locale: Locale = Astro.props.locale ?? "de";
const t = translate(locale);
const { levels, questions, sources } = getContent(locale);
import ExerciseEditor from "../../components/ExerciseEditor.astro";
import ProgressToggle from "../../components/ProgressToggle.astro";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import SourceCard from "../../components/SourceCard.astro";
import { topics as staticTopics, type Topic } from "../../data/content";
export function getStaticPaths() {
  return staticTopics.map((topic) => ({
    params: { slug: topic.id },
    props: { topic },
  }));
}
interface Props { locale?: Locale; topic: Topic }
const { topic } = Astro.props;
const question = questions.find((question) => question.topic === topic.id);
const reviewDates = [...new Set(topic.lesson?.sources.map(id=>sources[id].reviewedAt))].sort().map(date=>new Intl.DateTimeFormat(locale,{dateStyle:"medium",timeZone:"UTC"}).format(new Date(date))).join(" · ");
---

<Layout locale={locale} title={`${topic.title} – ${t("Einstieg & Übungen", "Introduction & practice")}`} description={topic.description} active="themen">
  <div class="container page-top">
    <a class="back-link" href={localePath(locale, "/#themenwelten")}>
      {t("← Alle Themenwelten", "← All topics")}
    </a>
    <div class={`topic-page-header color-${topic.color}`}>
      <span class="large-topic-icon">
        <Icon name={topic.icon} size={37} />
      </span>
      <p class="eyebrow">{t("DEINE THEMENWELT", "YOUR TOPIC")}</p>
      <h1>{topic.title}</h1>
      <p class="page-lead">{topic.description}</p>
      <div class="topic-tags">
        {topic.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </div>
  </div>
  <div class="container detail-layout section">
    <div class="detail-main">
      <section class="prerequisite">
        <Icon name="spark" size={22} />
        <div>
          <h2>{t("Was du mitbringen solltest", "What you should know first")}</h2>
          <p>{topic.prerequisites}</p>
        </div>
      </section>
      {topic.subareas && (
        <section id="teilbereiche">
          <h2>{t("Dokumente & Textsatz", "Documents & typesetting")}</h2>
          {topic.subareas.map((subarea) => (
            <div class="editorial-note">
              <Icon name="book" />
              <div>
                <h3>{subarea.title}</h3>
                <p>{subarea.description}</p>
                <p>
                  <strong>{subarea.languages.join(" · ")}</strong>
                </p>
                <p>
                  {t("Quellen:", "Sources:")}{" "}
                  {subarea.sources.map((id, index) => (
                    <>
                      {index > 0 && " · "}
                      <a
                        href={sources[id].url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {sources[id].publisher}
                        <span class="sr-only"> {t("(öffnet in neuem Tab)", "(opens in a new tab)")}</span> ↗
                      </a>
                    </>
                  ))}
                </p>
              </div>
            </div>
          ))}
        </section>
      )}
      <section id="themenplan">
        <p class="eyebrow">{t("DEIN WEG VOM EINSTIEG BIS ZUM PROFI", "YOUR ROUTE FROM BEGINNER TO ADVANCED")}</p>
        <h2>{t("Eine Richtung. Drei Lernstufen.", "One direction. Three levels.")}</h2>
        <p class="muted">
          {t("Die Themenlandkarte zeigt den geplanten Ausbau. Ausgearbeitete Einstiege findest du direkt darunter.", "The topic map outlines planned content. The available introductions follow below.")}
        </p>
        <div class="curriculum">
          {levels.map((level) => (
            <section class="curriculum-level" id={level.id}>
              <div class="curriculum-heading">
                <span>{level.number}</span>
                <div>
                  <h3>{level.name}</h3>
                  <p>{level.description}</p>
                </div>
              </div>
              <ul>
                {topic.curriculum[level.id].map((title, index) => (
                  <li>
                    <Icon name="book" size={17} />
                    <span>{title}</span>
                    <small>
                      {level.id === "einstieg" &&
                      topic.lesson &&
                      (topic.lesson.curriculumIndex !== undefined ? index === topic.lesson.curriculumIndex : ((topic.id === "datenbanken" && index === 1) ||
                        (topic.id !== "datenbanken" &&
                          index ===
                            (topic.id === "apis" ||
                            topic.id === "ki-neuronale-netze"
                              ? 2
                              : 0)))) ? (
                        <a href="#einstiegsartikel">{t("Einstieg lesen ↓", "Read introduction ↓")}</a>
                      ) : (
                        t("Geplant", "Planned")
                      )}
                    </small>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
      {topic.lesson ? (
        <article id="einstiegsartikel" class="lesson-article">
          <div class="article-label">
            <span class="level-badge">{t("Erster Einstieg", "First introduction")}</span>
            <span>{t("Quellenbasierter Entwurf", "Draft based on sources")}</span>
          </div>
          <h2>{topic.lesson.title}</h2>
          <p class="learning-goal">
            <strong>{t("Dein Lernziel:", "Your learning goal:")}</strong> {topic.lesson.goal}
          </p>
          {topic.lesson.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {topic.lesson.code && (
            <div class="code-example">
              <span>{topic.lesson.language} · {t("Beispiel", "Example")}</span>
              <pre><code>{topic.lesson.code}</code></pre>
            </div>
          )}
          <div class="takeaway">
            <Icon name="spark" size={22} />
            <p>
              <strong>{t("Zum Mitnehmen", "Takeaway")}</strong>
              {topic.lesson.takeaway}
            </p>
          </div>
          <ProgressToggle locale={locale} kind="lesson" contentId={topic.id} />
          <h3>{t("Worauf sich dieser Einstieg stützt", "What this introduction is based on")}</h3>
          <p class="article-review">
            {t("Gelesene Quellenstände:", "Source reading dates:")} {reviewDates}. {t("Ein unabhängiges Fachreview steht noch aus.", "An independent expert review is still pending.")}
          </p>
          {topic.lesson.sources.map((id) => (
            <SourceCard locale={locale} id={id} compact />
          ))}
          {question && (
            <a class="button primary" href={localePath(locale, `/quiz/?thema=${topic.id}`)}>
              {t("Verständnisfrage ausprobieren", "Try a question")} <Icon name="arrow" size={18} />
            </a>
          )}
        </article>
      ) : (
        <div class="planned-note">
          <Icon name="book" size={28} />
          <h3>{t("Hier entsteht dein nächster Einstieg.", "Your next introduction is taking shape.")}</h3>
          <p>
            {t("Die Themenstruktur steht. Die Lerntexte und Fragen werden erst ergänzt, wenn ihre Aussagen mit passenden Quellen belegt sind.", "The topic structure is ready. Articles and questions will be added once suitable sources support their statements.")}
          </p>
          <a class="text-link" href="#quellen">
            {t("Schon jetzt in den Originalquellen lesen ↓", "Read the original sources now ↓")}
          </a>
        </div>
      )}
      <ExerciseEditor topic={topic.id} locale={locale} />
      <section id="quellen" class="detail-sources">
        <p class="eyebrow">{t("WEITERLESEN & NACHPRÜFEN", "READ MORE & CHECK THE SOURCES")}</p>
        <h2>{t("Quellen für diese Themenwelt", "Sources for this topic")}</h2>
        <p class="muted">
          {t("Diese Quellen bilden den Anfang. Sie belegen noch nicht alle geplanten Vertiefungs- und Profi-Themen.", "These sources are a starting point. They do not yet support every planned intermediate or advanced lesson.")}
        </p>
        {topic.sources.map((id) => (
          <SourceCard locale={locale} id={id} />
        ))}
      </section>
    </div>
    <aside class="detail-sidebar">
      <div class="sidebar-sticky">
        <p class="eyebrow">{t("AUF DIESER SEITE", "ON THIS PAGE")}</p>
        <nav aria-label={t("Inhaltsverzeichnis", "Table of contents")}>
          {topic.subareas && <a href="#teilbereiche">{t("Dokumente & Textsatz", "Documents & typesetting")}</a>}
          <a href="#themenplan">{t("Themenplan", "Topic outline")}</a>
          {levels.map((level) => (
            <a href={`#${level.id}`}>
              {level.number} · {level.name}
            </a>
          ))}
          {topic.lesson && (
            <a href="#einstiegsartikel">{t("Ersten Einstieg lesen", "Read the first introduction")}</a>
          )}
          <a href="#uebungseditor">{t("Im Editor üben", "Practice in the editor")}</a>
          <a href="#quellen">{t("Quellen & Belege", "Sources & evidence")}</a>
        </nav>
        <div class="sidebar-note">
          <Icon name="book" size={24} />
          <h3>{t("Dein Tempo zählt.", "Your pace matters.")}</h3>
          <p>
            {t("Eine Lernstufe ist eine Orientierung. Du kannst Grundlagen jederzeit nachlesen.", "A level is a guide. You can return to the foundations at any time.")}
          </p>
          <a href={localePath(locale, "/lernpfade/")}>{t("Passende Lernwege →", "Related learning paths →")}</a>
        </div>
      </div>
    </aside>
  </div>
</Layout>
