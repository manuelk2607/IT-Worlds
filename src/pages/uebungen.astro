---
import Layout from '../layouts/Layout.astro';
import { exercises } from '../data/exercises';
import { getContent, translate, localePath, type Locale } from '../lib/i18n';
interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? 'de';
const t=translate(locale);
const {topicById}=getContent(locale);
---
<Layout locale={locale} title={t('Übungseditoren für zehn IT-Themen', 'Practice editors for ten IT topics')} description={t('Löse kleine Aufgaben zu Python, SQL, HTML, KI, APIs, UTF-8, DNS, MFA, Containern und Linux-Dateirechten. Ohne Anmeldung, mit Hinweisen und Musterlösungen.', 'Solve small tasks about Python, SQL, HTML, AI, APIs, UTF-8, DNS, MFA, containers and Linux permissions. No account needed, with hints and sample solutions.')} active="uebungen">
  <section class="container page-top page-intro"><p class="eyebrow">{t('LESEN. ÄNDERN. VERSTEHEN.', 'READ. EDIT. UNDERSTAND.')}</p><h1>{t('Dein Wissen', 'Your knowledge')}<br /><span>{t('ausprobieren.', 'in practice.')}</span></h1><p class="page-lead">{t('Eine kleine Editor-Aufgabe für jede Themenwelt. Ändere die Vorlage, prüfe das Ergebnis und nutze bei Bedarf Hinweis und Musterlösung.', 'A small editor task for every topic. Edit the template, check the result and use a hint or solution when needed.')}</p><p class="muted">{t('Die lokalen Lernmodelle prüfen begrenzte Aufgabenformate. Es sind keine vollständigen Compiler oder Interpreter; Programmcode wird nicht ausgeführt. Alle Übungen bleiben ohne Account zugänglich.', 'The local learning models check limited task formats. These are not full compilers or interpreters; program code is not executed. Every task remains accessible without an account.')}</p></section>
  <section class="container section"><div class="path-grid">{exercises.map(exercise=><article class="progress-entry"><p class="eyebrow">{topicById(exercise.topic)!.title}</p><h2>{exercise.title[locale]}</h2><p>{exercise.task[locale]}</p><a class="button primary" href={localePath(locale,`/themen/${exercise.topic}/#uebungseditor`)}>{t('Im Editor üben →', 'Open practice editor →')}</a></article>)}</div></section>
</Layout>
