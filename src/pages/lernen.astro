---
import Layout from '../layouts/Layout.astro';
import {getContent,translate,localePath,type Locale} from '../lib/i18n.ts';
import {courses,coursePath} from '../data/courses.ts';
import CourseCard from '../components/CourseCard.astro';
import PracticeProjects from '../components/PracticeProjects.astro';
interface Props {locale?: Locale}
const locale=Astro.props.locale??'de';const t=translate(locale);const {topics}=getContent(locale);
const first=courses.find(course=>course.topic==='it-grundlagen');
---
<Layout locale={locale} title={t('Dein Lernstart · Orientierung und Kurse','Your learning start · orientation and courses')} description={t('Finde einen passenden Einstieg: IT-Grundlagen, verfügbare Kurse, praktische Übungen und Quizfragen. Alle Inhalte ohne Anmeldung.','Find your starting point: IT foundations, available courses, practical exercises and quiz questions. All content is accessible without signing in.')}>
 <header class="container page-top"><p class="eyebrow">{t('DEIN NÄCHSTER SCHRITT','YOUR NEXT STEP')}</p><h1>{t('Wo möchtest du anfangen?','Where would you like to start?')}</h1><p class="page-lead">{t('Du brauchst keinen Account und musst nicht alles der Reihe nach lernen. Wähle zuerst ein Ziel.','You need no account and do not have to learn everything in sequence. Choose a goal first.')}</p></header>
 <section class="container section start-options" aria-label={t('Einstieg wählen','Choose a starting point')}>
  <a href={localePath(locale,first?coursePath(first):'/themen/it-grundlagen/#einstiegsartikel')}><span>01</span><h2>{t('Ich fange neu an','I am new to IT')}</h2><p>{t('Beginne mit den IT-Grundlagen und einem kleinen nachvollziehbaren Beispiel.','Begin with IT foundations and a small worked example.')}</p><strong>{t('Grundlagen öffnen →','Open foundations →')}</strong></a>
  <a href={localePath(locale,'/lernpfade/#kurse')}><span>02</span><h2>{t('Ich möchte etwas aufbauen','I want to build something')}</h2><p>{t('Wähle einen Kurs mit aufeinander aufbauenden Kapiteln, Praxis und Abschlussprojekt.','Choose a course with progressive chapters, practice and a final project.')}</p><strong>{t('Verfügbare Kurse →','Available courses →')}</strong></a>
  <a href={localePath(locale,'/quiz/')}><span>03</span><h2>{t('Ich möchte mein Wissen prüfen','I want to test my knowledge')}</h2><p>{t('Filtere Fragen nach Thema und Stufe. Jede Antwort wird erklärt.','Filter questions by topic and level. Every answer is explained.')}</p><strong>{t('Zum Wissensquiz →','Go to the quiz →')}</strong></a>
 </section>
 <section class="container section"><div class="section-heading"><div><h2>{t('Ein Thema, ein klarer Lernweg','One topic, a clear learning route')}</h2><p>{t('Diese Kurse sind mit allen Kapiteln verfügbar. Beginne bei den Voraussetzungen oder steige gezielt ein.','Every chapter of these courses is available. Start with prerequisites or jump to what you need.')}</p></div><a class="text-link" href={localePath(locale,'/lernpfade/')}>{t('Alle Kurse & Lernpfade →','All courses & learning paths →')}</a></div><div class="catalog-grid">{courses.slice(0,3).map(course=><CourseCard course={course} locale={locale}/>)}</div></section>
 <section class="container section"><h2>{t('Lieber selbst stöbern?','Prefer to explore?')}</h2><nav class="topic-directory" aria-label={t('Alle Themenwelten','All topics')}>{topics.map(topic=><a href={localePath(locale,`/themen/${topic.id}/`)}>{topic.title}<span>→</span></a>)}</nav><p>{t('Schon etwas gelernt? Ein freiwilliger Account speichert gelesene Kapitel und Quizantworten geräteübergreifend.','Already started learning? An optional account synchronises read chapters and quiz answers across devices.')} <a class="text-link" href={localePath(locale,'/fortschritt/')}>{t('Zum Lernstand →','View progress →')}</a></p></section>
 <section class="container section"><h2>{t('Einen Begriff nachschlagen','Look up a term')}</h2><p>{t('Im Glossar findest du kurze quellenbelegte Erklärungen mit direkten Wegen zu den passenden Kurskapiteln.','The glossary offers short sourced explanations linked directly to matching course chapters.')}</p><a class="button secondary" href={localePath(locale,'/glossar/')}>{t('Glossar öffnen →','Open the glossary →')}</a></section>
 <PracticeProjects locale={locale}/>
 <section class="container section"><h2>{t('Dokumente gestalten und prüfen','Design and check documents')}</h2><p>{t('Lerne Typst vom ersten Dokument bis zu Datenberichten und Präsentationen oder vertiefe LaTeX. Exportierte Projekte kannst du hier prüfen.','Learn Typst from your first document to data reports and presentations, or deepen LaTeX. Check exported projects here.')}</p><a class="button secondary" href={localePath(locale,'/textsatz/')}>{t('Typst & LaTeX entdecken →','Explore Typst & LaTeX →')}</a></section>
</Layout>
