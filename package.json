{
  "name": "it-worlds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "ready": "node --experimental-strip-types scripts/readiness.ts",
    "worker:dev": "wrangler dev --local --port 8787",
    "deploy:check": "node --experimental-strip-types scripts/release.ts --dry-run",
    "deploy": "node --experimental-strip-types scripts/release.ts",
    "dev:full": "npm run build && wrangler dev --local --port 8787",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "provision:runtime": "node --experimental-strip-types scripts/provision-runtime.ts",
    "seo:check": "node --experimental-strip-types scripts/seo-check.ts",
    "links:check": "node --experimental-strip-types scripts/links-check.ts"
  },
  "dependencies": {
    "@neon/config": "1.9.2",
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "astro": "7.4.1",
    "katex": "0.19.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@astrojs/markdown-satteri": "0.4.4",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "@neondatabase/auth": {
      "zod": "4.6.7"
    },
    "@neondatabase/auth-ui": {
      "zod": "4.6.7"
    },
    "undici@7.29.1": "7.30.1"
  }
}
