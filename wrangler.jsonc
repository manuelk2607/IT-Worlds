{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "it-worlds",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/en/*",
      "/",
      "/themen/*",
      "/lernpfade/*",
      "/lernen/*",
      "/uebungen/*",
      "/projekte/*",
      "/glossar/*",
      "/quiz/*",
      "/quellen/*",
      "/konto/*",
      "/fortschritt/*"
    ]
  },
  "account_id": "ec3c070d8e4f88d2fc533d7d797f2daa",
  "compatibility_flags": [],
  "logpush": false,
  "main": "worker/index.ts"
}
